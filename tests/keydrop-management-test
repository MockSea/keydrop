    def test_store_rotate_metadata_and_no_leaks(self):
        self.h._store('/token','add','typed',self.fields(note='Development',rotate_by='2000-01-01'))
        self.assertEqual(self.responses[-1][0],303)
        raw=KD.keychain_get('typed')
        self.assertEqual(KD.item_value('typed',raw,'client_secret'),'private-secret-value')
        with self.assertRaises(KD.KeydropError):KD.item_value('typed',raw)
        page=KD.render_vault('/token','csrf',KD.keychain_entries(),KD.read_notes(),None)
        self.assertIn('Overdue',page);self.assertIn('Development',page)
        for value in ['private-secret-value','private-client-id','https://example.com/callback']:
            self.assertNotIn(value,page)
            for p in Path(KD.STATE_DIR).rglob('*'):
                if p.is_file():self.assertNotIn(value,p.read_text())
        self.h._store('/token','rotate','typed',self.fields(f_client_secret='rotated-secret',rotate_by='2099-01-01'))
        self.assertEqual(self.events[-1],('typed','rotate stored'))
        self.assertEqual(KD.item_value('typed',KD.keychain_get('typed'),'client_secret'),'rotated-secret')
        self.assertEqual(KD.read_items()['typed']['rotate_by'],'2099-01-01')
        self.assertEqual(os.stat(KD.ITEMS_FILE).st_mode & 0o777,0o600)
        self.h._delete('/token','typed');self.assertIsNone(KD.keychain_get('typed'))
        self.assertNotIn('typed',KD.read_items())

