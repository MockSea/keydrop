    def test_pending_request_for_the_name_refuses(self):
        KD.write_pending({"id": "put-pending", "name": "put-pending", "pid": os.getpid()})
        try:
            with patch.object(KD, "alive", return_value=True):
                self.assertEqual(self.run_put("put-pending", "--stdin", stdin="v")[0], 2)
        finally:
            os.unlink(os.path.join(KD.PENDING_DIR, "put-pending.json"))
