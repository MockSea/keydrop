        self.assertEqual(self.run_put("put-both", "--stdin", "--generate")[0], 2)
        self.assertEqual(self.run_put("put-neither")[0], 2)
        self.assertEqual(self.run_put("put-len-stdin", "--stdin", "--length", "30", stdin="v")[0], 2)

    def test_value_on_argv_is_rejected(self):
        for args in (["put-argv", "value-on-argv"], ["put-argv", "--stdin", "value-on-argv"],
                     ["put-argv", "--value", "value-on-argv"], ["put-argv", "--password=value-on-argv"]):
            with self.subTest(args=args):
                code, out, err = self.run_put(*args, stdin="from-stdin")
                self.assertEqual(code, 2)
                self.assertNotIn("value-on-argv", out + err)
        self.assertIsNone(KD.keychain_get("put-argv"))

    def test_invalid_name(self):
        for name in ("Upper", "../escape", "a b", "x" * 65, "line\nbreak"):
            with self.subTest(name=name):
                code, _, err = self.run_put(name, "--stdin", stdin="v")
