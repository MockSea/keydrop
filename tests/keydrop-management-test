    def test_hostile_schema(self):
        bad = [None, [], {}, {'service': 'x', 'fields': []}]
        for key, value in [('service','../bad'), ('service','<script>'), ('service','a\n'), ('fields', [{}] * 13)]:
            x=copy.deepcopy(self.schema);x[key]=value;bad.append(x)
        for key, values in {'name':['A','x\n','../x','x'*33,[],None],
                            'label':['<img onerror=x>','x\x00','x'*81,None],
                            'kind':['file','script',[],None], 'required':['true',1,None],
                            'max':[0,8193,True,'5'], 'options':[['x']]}.items():
            for v in values:
                x=copy.deepcopy(self.schema);x['fields'][0][key]=v;bad.append(x)
        for extra in [{'default':'secret'}, {'script':'alert(1)'}, {'id':'other'}]:
            x=copy.deepcopy(self.schema);x['fields'][0].update(extra);bad.append(x)
        x=copy.deepcopy(self.schema);x['fields'][1]['name']=x['fields'][0]['name'];bad.append(x)
        x=copy.deepcopy(self.schema);x['fields'][1]['kind']='text';bad.append(x)
        for x in bad:
            with self.subTest(x=x), self.assertRaises(KD.KeydropError):KD.validate_schema(x)
        with self.assertRaises(ValueError):KD.schema_json('{"service":"x","service":"y"}')

