#!/usr/bin/env python3
"""Typed items and key management, as unit tests: no sockets, no tailscale.

The vault handler is built without a server (object.__new__ plus a namespace
standing in for it), and the keychain is the fake in tests/fakes.py, so this
runs on any machine with python3. Covers SPEC 5 (schemas, credential fields,
policy), 6 (request --type/--fields, get --field, list --long), 6.1 (put) and the keychain
adapter's limits.

    tests/keydrop-management-test
"""
import contextlib, copy, importlib.machinery, importlib.util, io, json, os, sys
from pathlib import Path
import tempfile, time, types, unittest
from unittest.mock import patch

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)
from fakes import fake_security  # noqa: E402

BASE = tempfile.TemporaryDirectory(prefix="keydrop-management-")
for var in ("KEYDROP_ACCOUNT", "KEYDROP_SERVICE_PREFIX", "KEYDROP_LAUNCHD_LABEL", "KEYDROP_TS_SOCKET"):
    os.environ.pop(var, None)
os.environ.update(KEYDROP_CONFIG=os.path.join(BASE.name, "no-such-config.json"),
                  KEYDROP_STATE_DIR=os.path.join(BASE.name, "state"),
                  KEYDROP_TAILSCALE=os.path.join(BASE.name, "no-tailscale"),
                  KEYDROP_OWNER_LOGIN="owner@example.com",
                  KEYDROP_SECURITY=fake_security(BASE.name))
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("kd", os.path.join(ROOT, "keydrop"))
spec = importlib.util.spec_from_loader(loader.name, loader)
KD = importlib.util.module_from_spec(spec)
loader.exec_module(KD)


class Management(unittest.TestCase):
    def setUp(self):
        KD.ensure_state()
        Path(KD.POLICY_FILE).write_text(json.dumps({'types_enabled': ['secret', 'credential']}))
        self.schema = KD.template_schema('linkedin')
        self.events, self.responses = [], []
        self.h = object.__new__(KD.VaultHandler)
        self.h.server = types.SimpleNamespace(write_allowed=lambda: True,
            audit=lambda *x: self.events.append(x), issue_csrf=lambda: 'csrf')
        self.h._page = lambda path, code=200, error='', **kw: self.responses.append((code, error, kw))
        self.h._done = lambda path, msg: self.responses.append((303, msg))
        self.h._send = lambda code, body, *a, **kw: self.responses.append((code, body))

    def fields(self, **extra):
        data = {'schema': json.dumps(self.schema), 'f_client_id': 'private-client-id',
                'f_client_secret': 'private-secret-value', 'f_redirect_uri': 'https://example.com/callback'}
        data.update(extra)
        return {k: [v] for k, v in data.items()}

    def test_type_marker_survives_metadata_loss(self):
