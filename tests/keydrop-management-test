    def test_security_line_limit_refuses_and_keeps_old_value(self):
        KD.keychain_store("big", "old value")
        too_long = "x" * (KD.KeychainVault().capabilities()["max_bytes"] + 100)
        with self.assertRaises(KD.KeydropError):
            KD.keychain_store("big", too_long)
        self.assertEqual(KD.keychain_get("big"), "old value")
        self.h._store("/token", "replace", "big", {"value": [too_long]})
        self.assertEqual(self.responses[-1][:2], (400, KD.TOO_LONG))
        self.assertEqual(KD.keychain_get("big"), "old value")
        fits = "y" * KD.KeychainVault().capabilities()["max_bytes"]
        KD.keychain_store("big", fits)
        self.assertEqual(KD.keychain_get("big"), fits)

    def test_list_long(self):
        self.h._store("/token", "add", "listed", self.fields())
        KD.keychain_store("plainlisted", "v")
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            self.assertEqual(KD.main(["list", "--long"]), 0)
        rows = {r.split("\t")[0]: r.split("\t") for r in out.getvalue().splitlines()}
        self.assertEqual(rows["listed"][1], "credential")
        self.assertEqual(rows["plainlisted"][1], "secret")
        self.assertEqual(len(rows["listed"]), 4)
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            KD.main(["list"])
        self.assertIn("listed\n", out.getvalue())
        self.assertNotIn("\t", out.getvalue())


class Put(unittest.TestCase):
    """SPEC 6.1: `put`, the local write path. Same validation, policy and
    verified store as the form; the value never on argv or stdout."""

    def setUp(self):
        KD.ensure_state()
        Path(KD.POLICY_FILE).write_text(json.dumps({"types_enabled": ["secret", "credential"]}))

    def run_put(self, *args, stdin=""):
        out, err = io.StringIO(), io.StringIO()
        with patch.object(sys, "stdin", io.StringIO(stdin)), \
                contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = KD.main(["put", *args])
        return code, out.getvalue(), err.getvalue()

    def state_text(self):
        return "".join(p.read_text() for p in Path(KD.STATE_DIR).rglob("*") if p.is_file())

    def test_generate_stores_and_prints_no_value(self):
        run = KD.subprocess.run
        with patch.object(KD.subprocess, "run", wraps=run) as spy:
            code, out, err = self.run_put("put-gen", "--generate", "--note", "a new account")
        self.assertEqual((code, out, err), (0, "stored put-gen\n", ""))
        value = KD.keychain_get("put-gen")
        self.assertEqual(len(value), KD.PUT_LENGTH)
        for cls in KD.PUT_CLASSES:
            self.assertTrue(any(c in cls for c in value), cls)
        for call in spy.call_args_list:
            self.assertNotIn(value, repr(call.args))
            self.assertNotIn(value.encode().hex(), repr(call.args))
        self.assertNotIn(value, self.state_text())
        self.assertEqual(KD.read_notes()["put-gen"], "a new account")
        self.assertEqual(KD.keychain_entries()["put-gen"]["type"], "secret")
        self.assertIn("put-gen\tput stored", Path(KD.LOG_FILE).read_text())
        # At the minimum length about 1 draw in 5 misses a class, so 200 draws
        # catch a generator that skips the class rule.
        for _ in range(200):
            drawn = KD.generate_password(KD.PUT_LENGTH_MIN)
            self.assertTrue(all(any(c in cls for c in drawn) for cls in KD.PUT_CLASSES), drawn)
        code, _, _ = self.run_put("put-len", "--generate", "--length", "40")
        self.assertEqual((code, len(KD.keychain_get("put-len"))), (0, 40))
        for bad in ("11", "129", "x"):
            with self.subTest(length=bad):
                self.assertEqual(self.run_put("put-badlen", "--generate", "--length", bad)[0], 2)
        self.assertIsNone(KD.keychain_get("put-badlen"))

    def test_credential_envelope_matches_the_form(self):
        h = object.__new__(KD.Handler)
        h.server = types.SimpleNamespace(name="put-cred", note="", schema=KD.request_schema("put-cred", "credential"),
                                         outcome=None)
        h._authorised = lambda: "/token"
        h._read_form = lambda n: {"f_username": ["agent@example.com"], "f_password": ["form-password"]}
        h._send = lambda *a: None
        h.do_POST()
        self.assertEqual(h.server.outcome, "stored")
        form_raw, form_meta = KD.keychain_get("put-cred"), KD.read_items()["put-cred"]
        form_type = KD.keychain_entries()["put-cred"]["type"]
        KD.keychain_delete("put-cred")
        KD.write_item_meta("put-cred", None, None)

        code, out, _ = self.run_put("put-cred", "--stdin", "--username", "agent@example.com",
                                    stdin="form-password\n")
        self.assertEqual((code, out), (0, "stored put-cred (username agent@example.com)\n"))
        self.assertEqual(KD.keychain_get("put-cred"), form_raw)
        self.assertNotIn("origin", form_meta)
        self.assertEqual(KD.read_items()["put-cred"], dict(form_meta, origin="put"))
        self.assertEqual(KD.keychain_entries()["put-cred"]["type"], form_type)
        self.assertEqual(json.loads(form_raw), {"keydrop": 1, "type": "credential",
                                                "fields": {"username": "agent@example.com",
                                                           "password": "form-password"}})
        got = io.StringIO()
        with contextlib.redirect_stdout(got):
            self.assertEqual(KD.main(["get", "put-cred", "--field", "password"]), 0)
        self.assertEqual(got.getvalue(), "form-password")

        code, out, _ = self.run_put("put-cred-gen", "--generate", "--username", "agent@example.com")
        self.assertEqual(code, 0)
        password = KD.item_value("put-cred-gen", KD.keychain_get("put-cred-gen"), "password")
        self.assertNotIn(password, out)
        self.assertEqual(KD.read_items()["put-cred-gen"]["schema"], KD.credential_schema("put-cred-gen"))

    def test_refuses_to_overwrite_without_replace(self):
        self.assertEqual(self.run_put("put-twice", "--stdin", stdin="first")[0], 0)
        KD.write_item_meta("put-twice", None, "2099-01-01", origin="put")
        code, out, err = self.run_put("put-twice", "--stdin", stdin="second")
        self.assertEqual((code, out), (2, ""))
        self.assertIn("--replace", err)
        self.assertEqual(KD.keychain_get("put-twice"), "first")
        code, out, _ = self.run_put("put-twice", "--stdin", "--replace", stdin="second")
        self.assertEqual((code, out), (0, "stored put-twice\n"))
        self.assertEqual(KD.keychain_get("put-twice"), "second")
        self.assertEqual(KD.read_items()["put-twice"]["rotate_by"], "2099-01-01")

    def audit_events(self, name):
        if not os.path.exists(KD.AUDIT_FILE):
            return []
        lines = Path(KD.AUDIT_FILE).read_text().splitlines()
        return [l.split("\t")[2] for l in lines if l.split("\t")[1] == name]

    def page_store(self, act, name, value):
        h = object.__new__(KD.VaultHandler)
        h.server = types.SimpleNamespace(write_allowed=lambda: True, audit=lambda *x: None,
                                         issue_csrf=lambda: "csrf")
        responses = []
        h._page = lambda path, code=200, error="", **kw: responses.append((code, error))
        h._done = lambda path, msg: responses.append((303, msg))
        h._rate_limited = lambda *a: False
        h._store("/token", act, name, {"value": [value]})
        self.assertEqual(responses[-1][0], 303, responses)

    def assert_replace_refused(self, name, kept):
        code, out, err = self.run_put(name, "--stdin", "--replace", stdin="from-put")
        self.assertEqual((code, out), (2, ""))
        self.assertIn("not stored by put", err)
        self.assertNotIn(kept, err)
        self.assertNotIn("from-put", err)
        self.assertEqual(KD.keychain_get(name), kept)
        self.assertEqual(self.audit_events(name)[-1], "put refused")

    def test_replace_refused_on_a_page_stored_item(self):
        self.page_store("add", "put-page", "page-value")
        self.assert_replace_refused("put-page", "page-value")
        # Without --replace too: the origin answer comes first.
        self.assertIn("not stored by put", self.run_put("put-page", "--generate")[2])
        # A put-made item stops being put's once a human changes it on the page.
        self.assertEqual(self.run_put("put-then-page", "--stdin", stdin="first")[0], 0)
        self.page_store("replace", "put-then-page", "human-value")
        self.assertNotIn("origin", KD.read_items()["put-then-page"])
        self.assert_replace_refused("put-then-page", "human-value")

    def test_replace_refused_on_an_item_with_no_origin(self):
        KD.keychain_store("put-legacy", "legacy-value")
        KD.write_item_meta("put-legacy", None, "")
        self.assert_replace_refused("put-legacy", "legacy-value")
        KD.keychain_store("put-no-meta", "unlisted-value")       # no items.json entry at all
        self.assertNotIn("put-no-meta", KD.read_items())
        self.assert_replace_refused("put-no-meta", "unlisted-value")
        # A hand-edited origin other than exactly "put" doesn't count.
        KD.keychain_store("put-odd", "odd-value")
        data = json.loads(Path(KD.ITEMS_FILE).read_text())
        data["put-odd"] = {"schema": None, "rotate_by": "", "origin": "PUT"}
        Path(KD.ITEMS_FILE).write_text(json.dumps(data))
        self.assert_replace_refused("put-odd", "odd-value")

    def test_replace_allowed_on_a_put_made_item_and_audited(self):
        code, _, _ = self.run_put("put-own", "--stdin", stdin="own-first")
        self.assertEqual(code, 0)
        self.assertEqual(KD.read_items()["put-own"]["origin"], "put")
        code, out, _ = self.run_put("put-own", "--stdin", "--replace", stdin="own-second")
        self.assertEqual((code, out), (0, "stored put-own\n"))
        self.assertEqual(KD.keychain_get("put-own"), "own-second")
        self.assertEqual(KD.read_items()["put-own"]["origin"], "put")
        self.assertEqual(self.audit_events("put-own"), ["put stored", "put replaced"])
        audit = Path(KD.AUDIT_FILE).read_text()
        for value in ("own-first", "own-second"):
            self.assertNotIn(value, audit)
        self.assertEqual(oct(os.stat(KD.AUDIT_FILE).st_mode & 0o777), "0o600")
        with patch.object(KD, "keychain_get", return_value=None):
            self.assertEqual(self.run_put("put-own", "--stdin", "--replace", stdin="own-third")[0], 1)
        self.assertEqual(self.audit_events("put-own")[-1], "put failed")

    def test_stdin(self):
        code, out, _ = self.run_put("put-token", "--stdin", stdin="tok-from-a-pipe\n")
        self.assertEqual((code, out), (0, "stored put-token\n"))
        self.assertEqual(KD.keychain_get("put-token"), "tok-from-a-pipe")
        self.assertNotIn("tok-from-a-pipe", self.state_text())
        self.assertEqual(self.run_put("put-empty", "--stdin", stdin="\n")[0], 1)
        self.assertEqual(self.run_put("put-huge", "--stdin", stdin="x" * 8193)[0], 2)
        for name in ("put-empty", "put-huge"):
