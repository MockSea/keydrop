        h._send = lambda code, body, *a, **kw: responses.append((code, body.decode(), "page"))
        return h, responses

    def test_a_refused_vault_add_comes_back_to_the_same_form(self):
        h, responses = self.vault_handler()
        schema = KD.template_schema("stripe")
        h._act("/t", "add", {"name": ["stripe-live"], "note": ["for billing"], "schema": [json.dumps(schema)],
                             "f_secret_key": [""], "f_publishable_key": ["pk_live_visible"]})
