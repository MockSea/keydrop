# ---------- 8. Medium: urlencoded parsing substitutes data, accepts short bodies ----------

class StrictBodies(PageTest):
    def post(self, srv, body, headers=(FORM,), length=True):
        return exchange(srv, build("POST", body=body, headers=list(headers), length=length))

    def test_invalid_utf8_escapes_are_refused_not_replaced(self):
        srv = make_page(name="pct-ff")
        csrf = csrf_of(self.form_page(srv))
        r = self.post(srv, f"csrf={csrf}&value=%FF".encode())
        self.assertEqual(r.status, 400)
        self.assertIsNone(stored("pct-ff"))

    def test_malformed_escapes_are_refused(self):
        srv = make_page(name="pct-bad")
        csrf = csrf_of(self.form_page(srv))
        for body in (f"csrf={csrf}&value=%G1", f"csrf={csrf}&value=abc%", f"csrf={csrf}&value=%4"):
            with self.subTest(body=body[-8:]):
                self.assertEqual(self.post(srv, body.encode()).status, 400)
        self.assertIsNone(stored("pct-bad"))

    def test_a_body_shorter_than_its_length_is_refused(self):
        srv = make_page(name="short-body")
        csrf = csrf_of(self.form_page(srv))
        body = f"csrf={csrf}&value=abc".encode()
        raw = (build("POST", headers=[FORM], length=False)[:-2]
               + f"Content-Length: {len(body) + 40}\r\n\r\n".encode() + body)
        r = exchange(srv, raw)
        self.assertEqual(r.status, 400)
        self.assertIsNone(stored("short-body"))

    def test_ambiguous_framing_is_refused(self):
        srv = make_page(name="framing")
        csrf = csrf_of(self.form_page(srv))
        body = f"csrf={csrf}&value=abc".encode()
        for extra in ([("Transfer-Encoding", "chunked")], [("Content-Length", str(len(body)))],
                      [("Content-Length", "+" + str(len(body)))]):
            with self.subTest(extra=extra):
                plus = extra[0][1].startswith("+")
                r = self.post(srv, body, [FORM] + extra, length=not plus)
                self.assertEqual(r.status, 400)
        self.assertIsNone(stored("framing"))

    def test_a_clean_body_still_parses(self):
        self.assertEqual(KD.parse_urlencoded(b"a=%C3%BC+x&b=&a=2", 10), {"a": ["ü x", "2"], "b": [""]})


# ---------- 9. Medium: unknown methods bypass the gates; bad bodies spend no strikes ----------

class Gates(PageTest):
    def test_an_unknown_method_gets_the_gates_and_the_headers(self):
        srv = make_page(name="trace")
        r = exchange(srv, build("TRACE", length=False, host="evil.example"))
        self.assertEqual(r.status, 404)
        self.assertIn("content-security-policy", r.headers)
        self.assertEqual(srv.bad, 0, "a wrong Host is never a strike")
        r = exchange(srv, build("PROPFIND", path="/wrong", length=False))
        self.assertEqual(r.status, 404)
        self.assertEqual(srv.bad, 1)

    def test_an_unknown_method_with_the_route_gone_ends_the_page(self):
        srv = make_page(name="trace-gone")
        with patch.object(KD, "serve_status", return_value={}):
            r = exchange(srv, build("TRACE", length=False))
        self.assertEqual(r.status, 404)
        self.assertEqual(srv.outcome, "route-gone")

    def test_a_malformed_request_line_gets_the_security_headers(self):
        srv = make_page(name="badline")
        for line in (b"GET /x HTTP/9.9\r\n\r\n", b"GET /x HTTP/1.x\r\n\r\n", b"GET\r\n\r\n"):
            with self.subTest(line=line):
                r = exchange(srv, line)
                self.assertIn("content-security-policy", r.headers)
                self.assertEqual(r.body, b"")

    def test_malformed_and_oversized_bodies_are_strikes(self):
        srv = make_page(name="strikes")
        csrf = csrf_of(self.form_page(srv))
        exchange(srv, build("POST", body=b"%%%", headers=[FORM]))
        self.assertEqual(srv.bad, 1)
        r = exchange(srv, build("POST", body=b"", headers=[FORM], length=False)[:-2]
                     + f"Content-Length: {KD.MAX_BODY + 1}\r\n\r\n".encode())
        self.assertEqual(r.status, 413)
        self.assertEqual(srv.bad, 2)
        exchange(srv, build("POST", body=form_body({"csrf": csrf, "value": "v", "extra": "x"}), headers=[FORM]))
        self.assertEqual(srv.bad, 3, "wrong fields are S-BAD-FORM too")
        self.assertIsNone(stored("strikes"))

    def test_home_strikes_a_bad_body_only_with_same_origin_fetch_metadata(self):
        KD.update_home(lambda st: {})
        srv = make_page("home")
        with patch.object(srv, "token_ok", return_value=True):
            exchange(srv, build("POST", body=b"%%%", headers=[FORM]))
            self.assertEqual(srv.bad, 0, "no Fetch Metadata: no strike")
            exchange(srv, build("POST", body=b"%%%", headers=[FORM, ("Sec-Fetch-Site", "same-origin")]))
            self.assertEqual(srv.bad, 1)
        KD.update_home(lambda st: {})


