def _vault_local(watch):
    url = vault_page("--ttl", "5m")
    check(link_shape_ok(), "vault: tailnet session link")
    token = url.rsplit("/", 1)[1]
    check(run("vault").returncode != 0, "vault: a second session is refused")
    check(KD.VAULT in run("status").stdout, "vault: status lists the session")

    code, body = http("GET", url)
    check(code == 404 and body == "", "vault: no login header, bare 404")
    code, page = http("GET", url, headers=LOGIN)
    check(code == 200 and "keydrop vault" in page, "vault: the owner's login gets the list")
    csrf = csrf_of(page)
    check(len(csrf) == 43 and csrf != token, "vault: page carries a separate form token")

    name, value, note = test_name("vault-add"), secret_value(), "for <the> tests"
    watch.needles += [value, value.encode().hex()]
    add = {"action": "add", "name": name, "note": note, "value": value}

    code, _ = vpost(url, add)
    check(code == 403 and KD.keychain_get(name) is None, "vault: add without form token refused")
    code, _ = vpost(url, dict(add, csrf=csrf[:-1] + ("A" if csrf[-1] != "A" else "B")))
    check(code == 403 and KD.keychain_get(name) is None, "vault: add with wrong form token refused")
    code, _ = vpost(url, dict(add, csrf=csrf), {"Sec-Fetch-Site": "cross-site"})
    check(code == 403 and KD.keychain_get(name) is None, "vault: cross-site POST refused even with the token")
    # Four strikes so far. Close this session properly and go on in a fresh one,
    # so the lockout (tested on its own below) doesn't end the run early.
    code, _ = vpost(url, {"csrf": csrf, "action": "done"})
    check(code == 200 and wait_gone(KD.VAULT), "vault: Done works after refused attempts")
    url = vault_page("--ttl", "5m")
    token = url.rsplit("/", 1)[1]
    code, page = http("GET", url, headers=LOGIN)
    check(csrf_of(page) not in ("", csrf), "vault: each session gets its own form token")
    code, _ = vpost(url, dict(add, csrf=csrf))
    check(code == 403 and KD.keychain_get(name) is None, "vault: the last session's form token is refused")
    csrf = csrf_of(page)
    code, _ = http("POST", url, data=urllib.parse.urlencode(dict(add, csrf=csrf)).encode(),
                   headers=dict(FORM, **{"Tailscale-User-Login": "x@example.com"}))
    check(code == 404 and KD.keychain_get(name) is None, "vault: POST with the wrong login stores nothing")
    q = urllib.parse.urlencode(dict(add, csrf=csrf))
    code, _ = http("GET", f"{url}?{q}", headers=LOGIN)
    check(code == 200 and KD.keychain_get(name) is None, "vault: a GET carrying the add fields changes nothing")

    code, page = vpost(url, dict(add, csrf=csrf))
    check(code == 200 and f"Stored {name}." in page, "vault: add stores (303 back to the list)")
    check(KD.keychain_get(name) == value, "vault: keychain holds the added value")
    check(name in page and "for &lt;the&gt; tests" in page, "vault: list shows the name and escaped note")
    check(value not in page and value.encode().hex() not in page, "vault: the page never shows the value")
    check(KD.read_notes().get(name) == note, "vault: note saved in meta.json")

    code, page = vpost(url, dict(add, csrf=csrf, value="other"))
    check(code == 409 and KD.keychain_get(name) == value, "vault: add over an existing name refused")

    time.sleep(1.1)   # mdat has one-second resolution
    before = KD.keychain_entries()[name]
    value2 = secret_value()
    watch.needles += [value2, value2.encode().hex()]
    code, page = vpost(url, {"csrf": csrf, "action": "replace", "name": name, "value": value2, "note": ""})
    check(code == 200 and KD.keychain_get(name) == value2, "vault: replace stores the new value")
    after = KD.keychain_entries()[name]
    check(after["created"] == before["created"] and after["updated"] > before["updated"],
          "vault: replace keeps created, moves updated")
    check(KD.read_notes().get(name) == note, "vault: blank note on replace keeps the old one")
    check(value2 not in page and value not in page, "vault: replace page shows no value")
    code, _ = vpost(url, {"csrf": csrf, "action": "replace", "name": test_name("vault-none"), "value": "x"})
    check(code == 404, "vault: replace of a name that doesn't exist refused")

    # delete: can't reach outside keydrop.*
    outside = make_outside_item()
    for bad in ("../" + outside, "../../" + name, name.upper(), "", "a/b", "x;y", "*"):
        for act in ("delete", "delete-confirm"):
            code, _ = vpost(url, {"csrf": csrf, "action": act, "name": bad})
            check(code == 400, f"vault: {act} refuses name {bad[:30]!r}")
    for other in (outside, "keydrop." + name):
        code, _ = vpost(url, {"csrf": csrf, "action": "delete-confirm", "name": other})
        check(code == 404, f"vault: delete-confirm {other[:30]!r} only looks under keydrop.*, finds nothing")
    check(outside_exists(outside) and KD.keychain_get(name) == value2,
          "vault: the non-keydrop item and the real entry both survive")

    code, page = vpost(url, {"csrf": csrf, "action": "delete", "name": name})
    check(code == 200 and f"Delete {name}?" in page and KD.keychain_get(name) == value2,
          "vault: delete asks to confirm and deletes nothing yet")
    code, _ = vpost(url, {"action": "delete-confirm", "name": name})
    check(code == 403 and KD.keychain_get(name) == value2, "vault: confirm without form token refused")
    code, page = vpost(url, {"csrf": csrf, "action": "delete-confirm", "name": name})
    check(code == 200 and f"Deleted {name}." in page and not KD.keychain_exists(name),
          "vault: confirmed delete removes the item")
    check(name not in KD.read_notes(), "vault: delete drops the note")
    check(name in pending_names() or KD.VAULT in pending_names(), "vault: session still open after changes")

    code, page = vpost(url, {"csrf": csrf, "action": "done"})
    check(code == 200 and "Closed" in page, "vault: Done closes it")
    check(wait_gone(KD.VAULT), "vault: server gone after Done")
    outs = log_outcomes(name)
    check(outs == ["vault add stored", "vault replace stored", "vault deleted"],
          f"vault log: add, replace, delete ({outs})")
    check(log_outcomes(KD.VAULT)[-1] == "done", "vault log: session done")
    with open(KD.LOG_FILE) as f:
        logtext = f.read()
    for label, needle in (("value", value), ("value 2", value2), ("token", token), ("form token", csrf),
                          ("hex value", value.encode().hex())):
        check(needle not in logtext, f"vault: log free of {label}")
        check(not state_contains(needle), f"vault: state dir free of {label}")


