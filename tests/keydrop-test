    body, ctype = multipart({"csrf": "c", "value": "ünï"}, {"file": b"a\r\nb\n", "file_key": b""}, "../../x.pem")
    got = pm(ctype, body, 10)
    check(got == {"csrf": ["c"], "value": ["ünï"], "file": [b"a\r\nb\n"], "file_key": [b""]},
          "parse_multipart: text parts are str, file parts stay raw bytes")
    check("../../x.pem" not in repr(got), "parse_multipart: the filename is never returned")
    check(refused(pm, ctype, body, 3) is not None, "parse_multipart: more parts than max_fields refused")
    dup, dctype = multipart({"value": "a"}, {"file": b"x"})
    dup = dup.replace(b'name="file"', b'name="value"')
    check(refused(pm, dctype, dup, 10) is not None, "parse_multipart: a name given twice refused")
    for label, bad_type in (("no boundary", "multipart/form-data"),
                            ("wrong type", ctype.replace("form-data", "mixed")),
                            ("boundary twice", ctype + "; boundary=x"),
                            ("bad boundary chars", "multipart/form-data; boundary=\"a\x01b\"")):
        check(refused(pm, bad_type, body, 10) is not None, f"parse_multipart: {label} refused")
    check(refused(pm, ctype, body + b"junk", 10) is not None, "parse_multipart: data after the close delimiter refused")
    check(refused(pm, ctype, body[:-8], 10) is not None, "parse_multipart: no close delimiter refused")
    star, sctype = multipart({"value": "a"})
    star = star.replace(b'name="value"', b"name*=utf-8''value")
