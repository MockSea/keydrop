def test_orphan_sweep(before):
    name = test_name("orphan")
    url = request(name, "--http")
    port = url.split(":")[2].split("/")[0]
    rec = next(r for r in KD.read_pending() if r["name"] == name)
    os.kill(rec["pid"], signal.SIGKILL)
    os.unlink(os.path.join(KD.PENDING_DIR, rec["id"] + ".json"))   # record lost too
    time.sleep(0.3)
    check(port in serve_ports() and name not in pending_names(), "route left with no record")
    check(port in KD.read_ledger(), "the route is in the ledger")
    # Another tool's route, shaped exactly like keydrop's, in the ephemeral range.
    foreign = next(str(p) for p in range(61500, 62000) if str(p) not in serve_ports())
    with open(STUB_JSON) as f:
        cfg = json.load(f)
    cfg.setdefault("TCP", {})[foreign] = {"HTTP": True}
    cfg.setdefault("Web", {})[f"{STUB_HOST}:{foreign}"] = {"Handlers": {"/": {"Proxy": f"http://127.0.0.1:{foreign}"}}}
    with open(STUB_JSON, "w") as f:
        json.dump(cfg, f)
    run("status")
    check(port not in serve_ports(), "reap sweeps an unowned ledgered route")
    check(port not in KD.read_ledger(), "and drops its ledger entry")
    check(foreign in serve_ports(), "a foreign same-shape route with no ledger entry survives the sweep")
    check(any(o == f"swept orphan :{port} ok" for o in log_outcomes("-")), "log: swept orphan")
    check(not any(o.startswith(f"swept orphan :{foreign}") for o in log_outcomes("-")), "log: foreign route not swept")
    with open(STUB_JSON) as f:
        cfg = json.load(f)
    cfg["TCP"].pop(foreign)
    cfg["Web"].pop(f"{STUB_HOST}:{foreign}")
    with open(STUB_JSON, "w") as f:
        json.dump(cfg, f)
    check(serve_ports() == before, "sweep touched nothing else")


