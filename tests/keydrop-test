    check(KD.login_ok(headers(("tailscale-user-login", KD.OWNER_LOGIN.upper()))),
          "login pin: header name and value compare case-insensitively")
    for label, hs in (("missing", ()),
                      ("wrong login", (("Tailscale-User-Login", "someone@example.com"),)),
