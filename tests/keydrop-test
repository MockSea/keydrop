def raw_post_length(url, length, ctype):
    """Headers claiming `length` bytes, and no body: the server must answer
    without reading one."""
    import http.client
    u = urllib.parse.urlsplit(url)
    conn = http.client.HTTPConnection(u.hostname, u.port, timeout=5)
    conn.putrequest("POST", u.path)
    for k, v in dict(LOGIN, **{"Content-Type": ctype, "Content-Length": str(length)}).items():
        conn.putheader(k, v)
    conn.endheaders()
    resp = conn.getresponse()
    code = resp.status
    conn.close()
    return code


