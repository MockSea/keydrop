# ---------- text-file uploads (SPEC 7.3, C-29) ----------

def multipart(fields, files=None, filename="upload.txt"):
    """(body, content type) for a browser-shaped multipart/form-data POST.
    files maps a part name to bytes; b"" is what a browser sends for a file
    input left empty (an empty part with filename="")."""
    boundary = "----kdtestBoundary" + secrets.token_hex(8)
    parts = []
    for k, v in fields.items():
        parts.append(f'Content-Disposition: form-data; name="{k}"\r\n\r\n'.encode() + v.encode())
    for k, data in (files or {}).items():
        fn = filename if data else ""
        parts.append(f'Content-Disposition: form-data; name="{k}"; filename="{fn}"\r\n'
                     f'Content-Type: application/octet-stream\r\n\r\n'.encode() + data)
    delim = b"--" + boundary.encode()
    body = delim + b"\r\n" + (b"\r\n" + delim + b"\r\n").join(parts) + b"\r\n" + delim + b"--\r\n"
    return body, f"multipart/form-data; boundary={boundary}"


def mpost(url, fields, files=None, filename="upload.txt"):
    body, ctype = multipart(fields, files, filename)
    return http("POST", url, data=body, headers=dict(LOGIN, **{"Content-Type": ctype}))


def pem_value(lines=4):
    """A PEM-shaped text value: several lines, newlines that must survive."""
    body = "\n".join(secrets.token_urlsafe(48)[:64] for _ in range(lines))
    return f"-----BEGIN PRIVATE KEY-----\n{body}\n-----END PRIVATE KEY-----\n"


def upload_schema(service):
    return {"service": service, "fields": [
        {"name": "private_key", "label": "Private key", "kind": "secret", "required": True,
         "max": 4096, "input": "file"},
        {"name": "key_id", "label": "Key ID", "kind": "text", "required": True, "max": 64},
        {"name": "team_id", "label": "Team ID", "kind": "text", "required": True, "max": 64},
    ]}


def refused(fn, *args):
    try:
        fn(*args)
        return None
    except KD.KeydropError as e:
        return str(e)


def test_upload_units():
