def csrf_of(page):
    m = re.search(r'name="csrf" value="([^"]+)"', page)
    return m.group(1) if m else ""


def vpost(url, fields, extra=None):
    return http("POST", url, data=urllib.parse.urlencode(fields).encode(),
                headers=dict(LOGIN, **FORM, **(extra or {})))


