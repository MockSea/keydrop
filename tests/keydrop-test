def test_orphan_shape():
    host = "keydrop-test.example.ts.net"

    def route(port, proxy, kind="HTTP", handlers=None):
        return {"TCP": {port: {kind: True}},
                "Web": {f"{host}:{port}": {"Handlers": handlers or {"/": {"Proxy": proxy}}}}}

    def merged(*routes):
        out = {"TCP": {}, "Web": {}}
        for r in routes:
            out["TCP"].update(r["TCP"])
            out["Web"].update(r["Web"])
        return out

    ours = [route("60183", "http://127.0.0.1:60183"),
            route("60190", "http://127.0.0.1:60190", "HTTPS")]
    ledger = {"60183": {"local": 60183, "plain_http": True},
              "60190": {"local": 60190, "plain_http": False}}
    # Another tool's routes, several shaped exactly like keydrop's. None is in
    # the ledger, so none may ever be swept.
    foreign = [
        route("61000", "http://127.0.0.1:61000"),              # identical shape to keydrop's
        route("61001", "http://127.0.0.1:61001", "HTTPS"),
        route("7317", "http://127.0.0.1:7317"),
        route("443", "http://127.0.0.1:3000", "HTTPS"),
    ]
    st = merged(*ours, *foreign)
    check(KD.orphan_routes(st, set(), ledger) == ([("60183", True, 60183), ("60190", False, 60190)], []),
          "orphan sweep picks exactly the ledgered routes (HTTP and HTTPS)")
    check(KD.orphan_routes(st, {"60183", "60190"}, ledger) == ([], []),
          "orphan sweep skips routes a record owns")
    check(KD.orphan_routes(st, set(), {}) == ([], []),
          f"orphan sweep leaves all {len(foreign)} unledgered routes alone, same-shape ones included")
    # Ledgered, but the route is gone or isn't what keydrop made any more:
    # the entry is stale, and the route (if any) is someone else's now.
    changed = [
        route("62000", "http://127.0.0.1:62001"),              # repointed
        route("62002", "http://127.0.0.1:62002", "HTTPS"),     # HTTP when made, HTTPS now
        route("62003", "http://127.0.0.1:62003",
              handlers={"/": {"Proxy": "http://127.0.0.1:62003"}, "/x": {"Path": "/tmp"}}),
        {"TCP": {"62004": {"HTTP": True, "TCPForward": "127.0.0.1:62004"}},
         "Web": {f"{host}:62004": {"Handlers": {"/": {"Proxy": "http://127.0.0.1:62004"}}}}},
    ]
    stale_ledger = {p: {"local": int(p), "plain_http": True} for p in ("62000", "62002", "62003", "62004", "62005")}
    check(KD.orphan_routes(merged(*changed), set(), stale_ledger) == ([], sorted(stale_ledger)),
          "a ledgered route that's gone, repointed or reshaped is stale, never swept")
    check(KD.orphan_routes({}, set(), {}) == ([], []) and KD.orphan_routes({"TCP": None}, set(), None) == ([], []),
          "orphan sweep copes with an empty config")

    # Funnel on for the page's port means the route isn't ours to trust.
    page = route("60183", "http://127.0.0.1:60183")
    check(KD.route_ours(page, 60183), "route_ours: a plain keydrop route")
    check(not KD.route_ours(dict(page, AllowFunnel={f"{host}:60183": True}), 60183),
          "route_ours refuses when Funnel is on for the port")
    check(KD.route_ours(dict(page, AllowFunnel={f"{host}:443": True, f"{host}:60183": False}), 60183),
          "route_ours ignores Funnel on another port")


# ---------- argv, deterministic ----------

def test_store_argv_intercepted():
    name, value = test_name("argv"), secret_value()
    seen = []
    real_run = KD.subprocess.run

    def spy(args, *a, **kw):
        seen.append((list(args), kw.get("input")))
        return real_run(args, *a, **kw)

    KD.subprocess.run = spy
    try:
        KD.keychain_store(name, value)
    finally:
        KD.subprocess.run = real_run
    hexed = value.encode().hex()
    argv_blob = " ".join(" ".join(a) for a, _ in seen)
    check(seen and seen[0][0] == [KD.SECURITY, "-i"], "store runs `security -i`")
    check(value not in argv_blob and hexed not in argv_blob, "store: value absent from every argv")
    check(any(i and hexed in i for _, i in seen), "store: value travels on stdin (as hex)")
    check(KD.keychain_get(name) == value, "keychain round-trips the value exactly")
    KD.keychain_store(name, value + "2")
    check(KD.keychain_get(name) == value + "2", "second store updates in place (-U)")


# ---------- a store that lies ----------

def lying_security(exit_code=0):
    """Swallows `security -i` and exits with exit_code without storing.
    Everything else (the read-back) goes to the fake keychain."""
    path = os.path.join(os.path.dirname(STATE), f"lying-security-{exit_code}")
    with open(path, "w") as f:
        f.write('#!/bin/sh\nif [ "$1" = "-i" ]; then cat >/dev/null; exit %d; fi\n'
                'exec %s "$@"\n' % (exit_code, shlex.quote(FAKE_SECURITY)))
    os.chmod(path, 0o700)
    return path


def test_store_verified():
    real = KD.SECURITY
    try:
        for code, label in ((0, "exit 0, nothing stored"), (45, "exit 45")):
            KD.SECURITY = lying_security(code)
            name = test_name("lie")
            try:
                KD.keychain_store(name, secret_value())
                check(False, f"store refuses to report success: {label}")
            except KD.KeydropError:
                check(True, f"store refuses to report success: {label}")
        # An existing item plus a silent no-op update: exit 0, item present,
        # old value. Only the digest comparison catches this one.
        name = test_name("stale")
        KD.SECURITY = real
        KD.keychain_store(name, "old value")
        KD.SECURITY = lying_security(0)
        try:
            KD.keychain_store(name, "new value")
            check(False, "store catches a no-op update over an old value")
        except KD.KeydropError as e:
            check("new value" not in str(e) and "old value" not in str(e),
                  "store catches a no-op update over an old value (and the error names neither)")
        KD.SECURITY = real
        for odd in ("back\\slash", "tab\there", 'q"uote', "tail space ", "0xdeadbeef"):
            n = test_name("odd")
            KD.keychain_store(n, odd)   # raises if the read-back disagrees
            check(KD.keychain_get(n) == odd, f"read-back agrees for {odd!r}")
    finally:
        KD.SECURITY = real

    # End to end: the page must not say Stored.
    os.environ["KEYDROP_SECURITY"] = lying_security(0)
    try:
        name, value = test_name("e2elie"), secret_value()
        url = page(name, "--ttl", "1m")
        code, body = http("POST", url, data=form(value, page_csrf(url)), headers=dict(LOGIN, **FORM))
        check(code == 500 and "Stored" not in body and value not in body,
              "page says it couldn't store, not Stored, when security lies")
        check(wait_gone(name) and log_outcomes(name)[-1] == "store-failed", "log: store-failed")
        check(KD.keychain_get(name) is None, "nothing in the keychain after the lying store")
    finally:
        os.environ["KEYDROP_SECURITY"] = FAKE_SECURITY


# ---------- end to end, localhost ----------

SHIM_NAME = "keydrop-security-shim"


def make_shim():
    """Delays, then execs security with the argv it was given. The
    process that holds the secret on stdin then sits in the process table for
    half a second, so the ps watcher sees it for certain rather than by luck;
    exec means what it sees is exactly the argv security runs with."""
    path = os.path.join(os.path.dirname(STATE), SHIM_NAME)
    with open(path, "w") as f:
        f.write('#!/bin/sh\nsleep 0.5\nexec %s "$@"\n' % shlex.quote(FAKE_SECURITY))
    os.chmod(path, 0o700)
    return path


def test_watch_can_see(watch):
    """Positive control: a needle that IS on argv must be caught, or the
    'never saw the value' checks below prove nothing."""
    canary = "canary-" + secrets.token_hex(8)
    watch.needles.append(canary)
    proc = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(5)", canary])
    end = time.time() + 5
    while time.time() < end and not any(n == canary for n, _ in watch.hits):
        time.sleep(0.1)
    proc.kill()
    proc.wait()
    check(any(n == canary for n, _ in watch.hits), "ps watcher catches a value that is on argv (control)")
    watch.needles.remove(canary)
    time.sleep(1)   # let an in-flight sample finish before clearing the control's hits
    watch.hits = [h for h in watch.hits if h[0] != canary]


def test_local_flow(watch):
    caught_before = watch.saw_security
    os.environ["KEYDROP_SECURITY"] = make_shim()
    for attempt in range(8):
        name, value = test_name("e2e"), secret_value()
        watch.needles += [value, value.encode().hex(), value.split(" ")[3]]
        url = page(name, "--note", '<b>"for tests"</b>', "--ttl", "1m")
        token = url.rsplit("/", 1)[1]
        base = url.rsplit("/", 1)[0]
        if attempt == 0:
            check(link_shape_ok(), "tailnet link shape, 256-bit token")
            check(name in pending_names(), "pending while waiting")
            check(run("request", name).returncode != 0, "second request for a pending name refused")
            st = run("status").stdout
            check(name in st and token not in st, "status lists it, without the token")
            code, body = http("GET", url, headers=LOGIN)
            check(code == 200 and "&lt;b&gt;&quot;for tests&quot;&lt;/b&gt;" in body and "<b>" not in body,
                  "GET /<token> serves the escaped form")
            wrong = token[:-1] + ("B" if token[-1] == "A" else "A")   # always differs
            code, body = http("GET", base + "/" + wrong, headers=LOGIN)
            check(code == 404 and body == "", "wrong token: bare 404")
            code, body = http("GET", base + "/", headers=LOGIN)
            check(code == 404 and body == "", "/: bare 404")
            code, _ = http("POST", url, data=form("", page_csrf(url)), headers=dict(LOGIN, **FORM))
            check(code == 400 and name in pending_names(), "empty submit is refused and doesn't consume the link")
            code, _ = http("POST", url, data=form(value), headers=dict(LOGIN, **FORM))
            check(code == 403 and name in pending_names() and KD.keychain_get(name) is None,
                  "a POST without the page's form token is refused: the link alone isn't enough")
        code, body = http("POST", url, data=form(value, page_csrf(url)), headers=dict(LOGIN, **FORM))
        if attempt == 0:
            check(code == 200 and "Stored" in body and value not in body, "POST stores and says so (via delayed security shim)")
            check(wait_gone(name), "server gone after submit")
            try:
                http("GET", url, headers=LOGIN)
                check(False, "link dead after submit")
            except (urllib.error.URLError, ConnectionError):
                check(True, "link dead after submit")
            check(KD.keychain_get(name) == value, "keydrop.<name> holds the submitted value")
            check(run("get", name).stdout == value, "`keydrop get` prints it")
            check(name in run("list").stdout.split(), "`keydrop list` shows the name")
            check(log_outcomes(name) == ["requested", "refused: form token (bad)", "stored"],
                  "log: requested, the token-less POST refused, stored")
        wait_gone(name)
        for needle in (value, value.encode().hex(), token):
            check(not state_contains(needle), f"state dir free of {'token' if needle == token else 'value'} (#{attempt})")
        if watch.saw_security > caught_before:
            break
    os.environ["KEYDROP_SECURITY"] = FAKE_SECURITY
    time.sleep(0.3)
    check(watch.saw_security > caught_before,
          f"ps watcher caught `security -i` mid-write ({watch.saw_security} sightings, {watch.samples} samples)")
    check(not watch.hits, "ps watcher never saw the value in any argv/env" + (f": {watch.hits[:2]}" if watch.hits else ""))


