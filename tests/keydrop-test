LAST_LINK = []


def loopback(link):
    """The page's tailnet link, as the 127.0.0.1 URL this suite sends to
    (the tailnet port is the loopback port). Remembers the link itself."""
    LAST_LINK[:] = [link]
    m = re.fullmatch(rf"https://{re.escape(STUB_HOST)}:(\d+)/([A-Za-z0-9_-]+)", link)
    if not m:
        raise AssertionError(f"not a stubbed tailnet link: {link[:60]!r}")
    return f"http://127.0.0.1:{m.group(1)}/{m.group(2)}"


def link_shape_ok():
    return bool(re.fullmatch(rf"https://{re.escape(STUB_HOST)}:\d+/[A-Za-z0-9_-]{{43}}", LAST_LINK[0]))


def check(cond, label):
    print(("ok   " if cond else "FAIL ") + label)
    if not cond:
        FAILS.append(label)


OUTSIDE = []


def test_name(tag):
    n = f"test-{tag}-{secrets.token_hex(3)}"
    MADE.add(n)
    return n


def secret_value():
    # Spaces, quotes, &, unicode: everything a naive quoting scheme would trip on.
    return f'kd "sekrit" & {secrets.token_hex(12)} ünï'


def run(*args, **kw):
    return subprocess.run([TOOL, *args], capture_output=True, text=True, **kw)


def request(*args):
    r = run("request", *args)
    if r.returncode != 0:
        raise AssertionError(f"request failed: {r.stderr}")
    return r.stdout.strip()


def page(*args):
    """A request page through the stub, as its loopback URL."""
    return loopback(request(*args))


def vault_page(*args):
    r = run("vault", *args)
    if r.returncode != 0:
        raise AssertionError(f"vault failed: {r.stderr}")
    return loopback(r.stdout.strip())


def http(method, url, data=None, headers=None):
    req = urllib.request.Request(url, data=data, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()


def form(value, csrf=""):
    return urllib.parse.urlencode({"value": value, "csrf": csrf}).encode()


def page_csrf(url):
    """The form token from a request page's own form: every POST to a page
    needs it, not just the link."""
    m = re.search(r'name="csrf" value="([^"]+)"', http("GET", url, headers=LOGIN)[1])
    return m.group(1) if m else ""


def pending_names():
    return [r["name"] for r in KD.read_pending()]


def wait_gone(name, secs=10):
    end = time.time() + secs
    while time.time() < end:
        if name not in pending_names():
            return True
        time.sleep(0.1)
    return False


def log_outcomes(name):
    try:
        with open(KD.LOG_FILE) as f:
            return [l.rstrip("\n").split("\t")[2] for l in f if l.split("\t")[1] == name]
    except FileNotFoundError:
        return []


def state_contains(needle):
    for root, _, files in os.walk(STATE):
        for fn in files:
            with open(os.path.join(root, fn), "rb") as f:
                if needle.encode() in f.read():
                    return True
    return False


class PsWatch(threading.Thread):
    """Poll every process's argv+env for any of the needles."""

    def __init__(self):
        super().__init__(daemon=True)
        self.needles, self.hits, self.saw_security, self.samples = [], [], 0, 0
        self.stop = False

    def run(self):
        while not self.stop:
            out = subprocess.run(["ps", "-axwwE", "-o", "command="],
                                 capture_output=True, text=True, errors="replace").stdout
            self.samples += 1
            for line in out.splitlines():
                if re.search(r"(security|keydrop-security-shim) -i\b", line):
                    self.saw_security += 1
                for n in list(self.needles):
                    if n in line:
                        self.hits.append((n, line[:160]))


