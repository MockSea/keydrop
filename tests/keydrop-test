def serve_ports():
    return stub_ports()


def ts_shim():
    """A tailscale that passes through to the stub unless the fault file says otherwise:
    `down` fails `serve ... off` and `serve status` (tailscaled unreachable),
    `noop-off` makes `off` exit 0 without doing anything."""
    base = os.path.dirname(STATE)
    fault = os.path.join(base, "ts-fault")
    open(fault, "w").close()
    path = os.path.join(base, "tailscale-shim")
    with open(path, "w") as f:
        f.write(f"""#!/bin/sh
mode=$(cat '{fault}' 2>/dev/null)
case "$mode:$*" in
  down:*"serve "*" off"|down:*"serve status"*) echo "failed to connect to local tailscaled" >&2; exit 1 ;;
  noop-off:*"serve "*" off") exit 0 ;;
esac
exec '{STUB}' "$@"
""")
    os.chmod(path, 0o700)
    return path, fault


def set_fault(fault, mode):
    with open(fault, "w") as f:
        f.write(mode)


def wait_record(name, pred, secs=10):
    end = time.time() + secs
    while time.time() < end:
        rec = next((r for r in KD.read_pending() if r["name"] == name), None)
        if pred(rec):
            return rec
        time.sleep(0.1)
    return None


def test_teardown_failure(before):
    shim, fault = ts_shim()
    os.environ["KEYDROP_TAILSCALE"] = shim
    try:
        for mode, why in (("down", "tailscaled unreachable"), ("noop-off", "`off` exits 0 but does nothing")):
            name = test_name("tdown")
            url = request(name, "--http", "--ttl", "2m")
            port = url.split(":")[2].split("/")[0]
            pid = next(r["pid"] for r in KD.read_pending() if r["name"] == name)
            set_fault(fault, mode)
            run("cancel", name)
            rec = wait_record(name, lambda r: r and r.get("teardown_failed"))
            check(rec is not None, f"{why}: record kept, marked teardown-failed")
            end = time.time() + 5
            while time.time() < end and KD.alive(pid):
                time.sleep(0.1)
            check(not KD.alive(pid), f"{why}: the server process itself still exits")
            check(port in serve_ports(), f"{why}: route really is still there (so keeping the record matters)")
            check("teardown-failed" in log_outcomes(name), f"{why}: log: teardown-failed")
            st = run("status").stdout
            check(name in pending_names() and "teardown failed" in st,
                  f"{why}: reap while still failing keeps the record, status says so")
            r2 = run("request", name, "--http", "--ttl", "5s")
            check(r2.returncode == 0,
                  f"{why}: a teardown-failed record doesn't block a new request for the name")
            port2 = r2.stdout.strip().split(":")[2].split("/")[0] if r2.returncode == 0 else port
            end = time.time() + 15
            while time.time() < end and any(KD.alive(x["pid"]) for x in KD.read_pending()
                                            if x["name"] == name and not x.get("teardown_failed")):
                time.sleep(0.1)
            check("expired" in log_outcomes(name), f"{why}: the new request finished on its own")
            set_fault(fault, "")
            run("status")
            check(name not in pending_names() and port not in serve_ports() and port2 not in serve_ports()
                  and log_outcomes(name)[-1] == "reaped",
                  f"{why}: once tailscale answers, the next reap removes routes and records")
    finally:
        os.environ["KEYDROP_TAILSCALE"] = STUB
        set_fault(fault, "")
    check(serve_ports() == before, "serve config back to exactly what it was after teardown-failure tests")


