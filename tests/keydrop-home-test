def test_install_line():
    """The documented install line takes keydrop from origin/main, not from
    the working tree or an unpushed commit. Run for real against a throwaway
    HOME with its own clone and bare origin."""
    with open(README) as f:
        blocks = re.findall(r"(?:^    \S.*\n)+", f.read(), re.M)
    blocks = [b for b in blocks if "install -m 0755" in b]
    check(len(blocks) == 1, "README documents one install block")
    if len(blocks) != 1:
        return
    lines = [l[4:] for l in blocks[0].splitlines()]
    home = os.path.join(BASE, "install-home")
    origin, clone = os.path.join(BASE, "origin.git"), os.path.join(home, "src", "keydrop")
    git = ["/usr/bin/git", "-c", "user.name=t", "-c", "user.email=t@example.com"]
    env = {"HOME": home, "PATH": "/usr/bin:/bin", "TMPDIR": os.path.join(BASE, "install-tmp")}
    os.makedirs(env["TMPDIR"])
    os.makedirs(os.path.join(home, ".local", "bin"))
    q = dict(capture_output=True, env=env, check=True)
    subprocess.run(git + ["init", "-q", "--bare", "-b", "main", origin], **q)
    subprocess.run(git + ["clone", "-q", origin, clone], **q)
    target = os.path.join(clone, "keydrop")

    def commit(text, push):
        with open(target, "w") as f:
            f.write(text)
        subprocess.run(git + ["-C", clone, "add", "-A"], **q)
        subprocess.run(git + ["-C", clone, "commit", "-qm", text], **q)
        if push:
            subprocess.run(git + ["-C", clone, "push", "-q", "origin", "HEAD:main"], **q)
    commit("old\n", True)
    other = os.path.join(BASE, "other-clone")    # the merge lands on origin from elsewhere
    subprocess.run(git + ["clone", "-q", origin, other], **q)
    with open(os.path.join(other, "keydrop"), "w") as f:
        f.write("reviewed\n")
    subprocess.run(git + ["-C", other, "commit", "-qam", "reviewed"], **q)
    subprocess.run(git + ["-C", other, "push", "-q", "origin", "HEAD:main"], **q)
    commit("unpushed\n", False)
    with open(target, "w") as f:
        f.write("uncommitted\n")
    # While the user reads the log, another push lands and gets fetched.
    g = " ".join(shlex.quote(a) for a in git)
    late = (f"printf 'unreviewed\\n' > {shlex.quote(os.path.join(other, 'keydrop'))} && "
            f"{g} -C {shlex.quote(other)} commit -qam unreviewed && "
            f"{g} -C {shlex.quote(other)} push -q origin HEAD:main && "
            f"{g} -C ~/src/keydrop fetch -q origin")
    at = next(i for i, l in enumerate(lines) if "install -m 0755" in l)
    script = "\n".join(lines[:at] + [late] + lines[at:]) + "\n"
    r = subprocess.run(["/bin/bash", "-e", "-c", script], capture_output=True, text=True, env=env)
    installed = os.path.join(home, ".local", "bin", "keydrop")
    got = open(installed).read() if os.path.exists(installed) else None
    check(r.returncode == 0 and got == "reviewed\n",
          "install block installs the commit it showed for review, not a later push, "
          f"an unpushed commit or the working tree ({got!r}, {r.stderr.strip()[:200]!r})")
    check("+reviewed" in r.stdout and "unreviewed" not in r.stdout,
          "the review step shows the change that gets installed")
    check(got is not None and oct(os.stat(installed).st_mode & 0o777) == "0o755", "installed 0755")


