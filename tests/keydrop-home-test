def test_header_spoofs(page, token):
    url = page.url(token)
    code, body = http("GET", url)
    check(code == 404 and body == "", "no login header: bare 404")
    for label, hs in (("wrong login", [("Tailscale-User-Login", "x@example.com")]),
                      ("underscore only", [("Tailscale_User_Login", KD.OWNER_LOGIN)]),
                      ("doubled", [("Tailscale-User-Login", KD.OWNER_LOGIN),
                                   ("Tailscale-User-Login", "x@example.com")])):
        raw = "".join(f"{k}: {v}\r\n" for k, v in hs)
        head = raw_get(page.port, token, raw)
        check(" 404 " in head, f"login {label}: 404")
        unlock()
    head = raw_get(page.port, token, f"Tailscale-User-Login: {KD.OWNER_LOGIN}\r\n"
                                     f"Tailscale_User_Login: {KD.OWNER_LOGIN}\r\n")
    check(" 404 " in head, "login with an underscore lookalike beside it: 404")
    n, v = name("spoof"), value()
    code, _ = post(url, {"action": "add", "name": n, "value": v},
                   {"Tailscale-User-Login": "x@example.com"}, login=False)
    check(code == 404 and KD.keychain_get(n) is None, "POST with the wrong login stores nothing")
    unlock()
    check(page.proc.poll() is None, "page still up after the spoof checks (with unlocks between)")


def raw_get(port, token, header_lines, method="GET", host=None):
    """Hand-built request, so duplicate headers go out exactly as written.
    host: the Host header (default 127.0.0.1:<port>; "" sends none)."""
    import socket
    try:
        s = socket.create_connection(("127.0.0.1", port), timeout=5)
    except ConnectionError:
        return "connection refused"
    host = f"127.0.0.1:{port}" if host is None else host
    hline = f"Host: {host}\r\n" if host else ""
    s.sendall(f"{method} /{token} HTTP/1.0\r\n{hline}{header_lines}\r\n".encode())
    out = b""
    while True:
        c = s.recv(65536)
        if not c:
            break
        out += c
    s.close()
    BODIES.append(out.decode(errors="replace"))
    return out.split(b"\r\n", 1)[0].decode()


def test_csrf(page, token):
    url = page.url(token)
    code, html = get(url)
    check(code == 200 and "keydrop" in html and "stays up" in html, "the owner's login gets the list")
    csrf = csrf_of(html)
    n, v = name("csrf"), value()
    add = {"action": "add", "name": n, "value": v}
    before = strikes()
    code, _ = post(url, add)
    check(code == 403 and KD.keychain_get(n) is None and strikes() == before + 1,
          "add without a form token: 403, counts")
    code, _ = post(url, dict(add, csrf="1." + "0" * 64))
    check(code == 403 and KD.keychain_get(n) is None, "add with a forged form token: 403")
    code, _ = post(url, dict(add, csrf=csrf), {"Origin": "https://evil.example"})
    check(code == 403 and KD.keychain_get(n) is None, "add from another site's Origin: 403")
    unlock()
    raw = urllib.parse.urlencode(dict(add, csrf=csrf)).encode()
    import socket
    s = socket.create_connection(("127.0.0.1", page.port), timeout=5)
    s.sendall((f"POST /{token} HTTP/1.0\r\nHost: 127.0.0.1:{page.port}\r\n"
               f"Tailscale-User-Login: {KD.OWNER_LOGIN}\r\nSec-Fetch-Site: same-origin\r\nOrigin: null\r\n"
               f"Origin: https://evil.example\r\nContent-Type: application/x-www-form-urlencoded\r\n"
               f"Content-Length: {len(raw)}\r\n\r\n").encode() + raw)
    head = s.recv(4096).split(b"\r\n", 1)[0].decode()
    s.close()
    check(" 403 " in head and KD.keychain_get(n) is None, "two Origin headers: 403")
    unlock()
    before = strikes()
    for _ in range(KD.MAX_BAD + 2):
        code, _ = post(url, dict(add, csrf=csrf), {"Sec-Fetch-Site": "cross-site"})
    check(code == 404 and strikes() == before and page.proc.poll() is None
          and KD.keychain_get(n) is None,
