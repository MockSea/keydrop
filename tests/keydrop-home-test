def render_plist(label, python, keydrop, log):
    with open(PLIST_TEMPLATE) as f:
        text = f.read()
    for k, v in (("__LABEL__", label), ("__PYTHON__", python), ("__KEYDROP__", keydrop), ("__LOG__", log)):
        text = text.replace(k, v)
    return text


def test_plist():
    """The launchd template renders to a valid plist that runs an installed
    copy with `home`, restarts only on failure, and leaves no placeholder."""
    import plistlib
    with open(PLIST_TEMPLATE) as f:
        found = set(re.findall(r"__[A-Z]+__", f.read()))
    check(found == {"__LABEL__", "__PYTHON__", "__KEYDROP__", "__LOG__"}, f"template placeholders ({sorted(found)})")
    installed = os.path.join(BASE, "bin", "keydrop")
    log = os.path.join(BASE, "home.launchd.log")
    out = os.path.join(BASE, "rendered.plist")
    text = render_plist(KD.LAUNCHD_LABEL, sys.executable, installed, log)
    with open(out, "w") as f:
        f.write(text)
    check(not re.search(r"__[A-Z]+__", text), "rendered plist has no placeholder left")
    lint = subprocess.run(["/usr/bin/plutil", "-lint", out], capture_output=True, text=True)
    check(lint.returncode == 0, "rendered plist passes plutil -lint")
    with open(out, "rb") as f:
        pl = plistlib.load(f)    # strict XML: the template's comment must not hold a double hyphen
    check(pl["Label"] == KD.LAUNCHD_LABEL, "plist label is the configured launchd label")
    check(pl["ProgramArguments"] == [sys.executable, installed, "home"], "plist runs <python> <installed copy> home")
    check(pl["KeepAlive"] == {"SuccessfulExit": False} and pl["RunAtLoad"] is True,
          "plist restarts only on failure, starts at load")
    check(pl["StandardOutPath"] == log == pl["StandardErrorPath"], "plist logs to the given path")


def test_fetch_metadata(page, token):
    """Round 2, finding 1. A strike needs the owner's login AND Sec-Fetch-Site of
    same-origin or none. Without Fetch Metadata (plain HTTP, a non-browser,
    an <img> on a page that got none) a failure is a bare 404 and no strike."""
    url = page.url(token)
    mo_bare = {"Tailscale-User-Login": KD.OWNER_LOGIN}
    before = strikes()
    for _ in range(KD.MAX_BAD + 1):
        code, body = http("GET", page.url(secrets.token_urlsafe(32)), headers=mo_bare)
    check(code == 404 and body == "" and strikes() == before and page.proc.poll() is None,
          f"{KD.MAX_BAD + 1} wrong tokens without Sec-Fetch-Site: bare 404, no strikes, page up")
    n = name("nofetch")
    forged = f"{int(time.time()) + 5}.{'0' * 64}"   # stamped after start: "bad", not "stale"
    code, body = http("POST", url, data=urllib.parse.urlencode(
        {"csrf": forged, "action": "add", "name": n, "value": value()}).encode(),
        headers=dict(mo_bare, **FORM))
    check(code == 404 and body == "" and strikes() == before and KD.keychain_get(n) is None,
          "a forged form token without Sec-Fetch-Site: bare 404, no strike, nothing stored")
    head = raw_get(page.port, "nope", f"Tailscale-User-Login: {KD.OWNER_LOGIN}\r\n"
                   "Sec-Fetch-Site: same-origin\r\nSec-Fetch-Site: same-origin\r\n")
    check(" 404 " in head and strikes() == before, "a doubled Sec-Fetch-Site doesn't count")
    code, _ = get(page.url("nope"), {"Sec-Fetch-Site": ""})
    check(code == 404 and strikes() == before, "an empty Sec-Fetch-Site doesn't count")
    code, _ = http("GET", url, headers=mo_bare)
    check(code == 200, "the right token without Sec-Fetch-Site still gets the page")
    code, _ = get(page.url("nope"), {"Sec-Fetch-Site": "none"})
