def make_stub():
    with open(STUB, "w") as f:
        f.write(STUB_SRC % (SERVE_JSON, ARGV_LOG, HOST, SLOW, STALLING, NOCERTS, ORDER_LOG, GARBLE, NOOFF))
    os.chmod(STUB, 0o700)


def serve_cfg():
    try:
        with open(SERVE_JSON) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def route_up():
    return str(KD.HOME_PORT) in (serve_cfg().get("TCP") or {})


# ---------- helpers ----------

def run(*args, timeout=60, **kw):
    return subprocess.run([TOOL, *args], capture_output=True, text=True, timeout=timeout, **kw)


def new_link():
    r = run("home", "--new-link", "--force")
    url = r.stdout.strip()
    m = re.fullmatch(rf"https://{re.escape(HOST)}:{KD.HOME_PORT}/([A-Za-z0-9_-]{{43}})", url)
    if m:
        TOKENS.append(m.group(1))
    return r, (m.group(1) if m else None)


class Page:
    """A running `keydrop home`, started the way launchd would start it."""

    def __init__(self, env=None):
        self.proc = subprocess.Popen([TOOL, "home"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                     text=True, env=dict(os.environ, **(env or {})))
        self.port = None
        end = time.time() + 10
        while time.time() < end and self.proc.poll() is None:
            rec = next((r for r in KD.read_pending() if r.get("kind") == "home"
                        and r.get("pid") == self.proc.pid), None)
            if rec and route_up() and accepts(rec["local_port"]):
                self.port = rec["local_port"]
                return
            time.sleep(0.05)

    def url(self, token):
        return f"http://127.0.0.1:{self.port}/{token}"

    def wait(self, secs=10):
        try:
            return self.proc.wait(secs)
        except subprocess.TimeoutExpired:
            return None

    def kill(self):
        if self.proc.poll() is None:
            self.proc.send_signal(signal.SIGTERM)
            self.wait()


def accepts(port, timeout=0.2):
    import socket
    try:
        socket.create_connection(("127.0.0.1", port), timeout).close()
        return True
    except OSError:
        return False


def order_log():
    return [json.loads(line) for line in log_lines(ORDER_LOG)]


def listening_tcp(pid):
    """Every TCP address the process listens on, from lsof."""
    r = subprocess.run(["/usr/sbin/lsof", "-nP", "-a", "-p", str(pid), "-iTCP", "-sTCP:LISTEN", "-Fn"],
                       capture_output=True, text=True, timeout=10)
    return sorted(line[1:] for line in r.stdout.splitlines() if line.startswith("n"))


def http(method, url, data=None, headers=None):
    req = urllib.request.Request(url, data=data, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            code, body = resp.status, resp.read().decode()
    except urllib.error.HTTPError as e:
        code, body = e.code, e.read().decode()
    except urllib.error.URLError:
        code, body = 0, ""          # page gone (locked out): a check fails, not the run
    BODIES.append(body)
    return code, body


def get(url, extra=None):
    return http("GET", url, headers=dict(LOGIN, **(extra or {})))


def post(url, fields, extra=None, login=True):
    return http("POST", url, data=urllib.parse.urlencode(fields).encode(),
                headers=dict(LOGIN if login else {}, **FORM, **(extra or {})))


def csrf_of(page):
    m = re.search(r'name="csrf" value="([^"]+)"', page)
    return m.group(1) if m else ""


def strikes():
    return len(KD.recent(KD.read_home().get("bad"), KD.HOME_BAD_WINDOW))


def name(tag):
    n = f"test-home-{tag}-{secrets.token_hex(3)}"
    MADE.add(n)
    return n


def value():
    v = f'kd "home" & {secrets.token_hex(12)} ünï'
    VALUES.append(v)
    return v


def log_lines(path):
    try:
        with open(path) as f:
            return f.read().splitlines()
    except FileNotFoundError:
        return []


def state_contains(needle):
    for root, _, files in os.walk(STATE):
        for fn in files:
            with open(os.path.join(root, fn), "rb") as f:
                if needle.encode() in f.read():
                    return True
    return False


def restart(page):
    page.kill()
    unlock()
    return Page()


def unlock():
    run("home", "--unlock", "--force")


def unlock_in_process():
    KD.update_home(lambda st: dict(st, bad=[], locked=None, stopped=None))


# ---------- units ----------

def test_units():
    KD.ensure_state()
    srv = KD.Home(pin=True, port=0)
    try:
        tok = srv.issue_csrf()
        check(srv.check_csrf(tok) == "ok", "unit: a fresh form token is ok")
        check(srv.check_csrf(srv.issue_csrf()) == "ok" and srv.issue_csrf().split(".")[0].isdigit(),
              "unit: every page gets its own stamped form token")
        old = str(int(time.time()) - KD.CSRF_MAX_AGE - 10)
        import hashlib, hmac
        aged = old + "." + hmac.new(srv._csrf_key, old.encode(), hashlib.sha256).hexdigest()
        check(srv.check_csrf(aged) == "stale", "unit: a real but aged form token is stale, not bad")
        later = str(int(srv.started) + 5)
        same = str(int(srv.started))
        for bad in ("", "x", tok[:-1] + ("0" if tok[-1] != "0" else "1"), later + "." + "0" * 64,
                    same + "." + "0" * 64, old + ".", "-1.abc", tok + "x", "\u00b2." + "0" * 64):
            check(srv.check_csrf(bad) == "bad", f"unit: forged form token {bad[:16]!r} is bad")
        # Finding 3: a well-formed token stamped before this process started
        # can't be verified (its key died with the old process) and is
        # treated as stale, not as a strike. Garbled ones stay bad.
        before = str(int(srv.started) - 3600)
        check(srv.check_csrf(before + "." + secrets.token_hex(32)) == "stale",
              "unit: a well-formed token stamped before this process started is stale")
        for garbled in (before + "." + "0" * 63, before + "." + "Z" * 64,
                        before + "." + secrets.token_hex(32).upper(), before + "." + "0" * 65,
                        before + "x." + "0" * 64):
            check(srv.check_csrf(garbled) == "bad", f"unit: garbled pre-start token {garbled[-8:]!r} is bad")
        time.sleep(1.1)
        other = KD.Home(pin=True, port=0)
        check(other.check_csrf(tok) == "stale",
              "unit: a form token from an earlier process is stale, not bad")
        other.server_close()
        srv._minute = []
        ok = [srv.under_rate() for _ in range(KD.REQUESTS_PER_MINUTE)]
        check(all(ok) and not srv.under_rate(), f"unit: request rate caps at {KD.REQUESTS_PER_MINUTE}/min")
        # Finding 2: a stop or a lock reads as a full strike count, so the
        # serve loop ends, and refusal() names it, so serve_child won't route.
        check(srv.bad == 0 and srv.refusal() is None, "unit: no flags, no strikes, no refusal")
        KD.update_home(lambda st: dict(st, stopped={"at": time.time(), "why": "test"}))
        check(srv.bad >= KD.MAX_BAD, "unit: a stopped page reads as MAX_BAD (the serve loop exits)")
        check(srv.refusal() == "stopped", "unit: refusal() says stopped")
        srv.bad += 1
        check(strikes() <= 1, "unit: a strike while stopped adds one strike, not a pile")
        KD.update_home(lambda st: dict(st, stopped=None, bad=[], locked={"at": time.time(), "why": "t"}))
        check(srv.bad >= KD.MAX_BAD and srv.refusal() == "locked", "unit: refusal() says locked")
        unlock_in_process()
    finally:
        srv.server_close()
    page = KD.render_vault("/t", "c", {}, {}, None, title="keydrop", done_label="Stop this page")
    check("stays up" in page and "Stop this page" in page and "Link ends" not in page,
          "unit: home page renders without an expiry")
    st = {"TCP": {"9443": {"HTTPS": True}},
          "Web": {f"{HOST}:9443": {"Handlers": {"/": {"Proxy": "http://127.0.0.1:50000"}}}}}
    check(KD.home_route(st, 9443) == 50000, "unit: home_route recognises its own route")
    st2 = {"TCP": {"9443": {"HTTPS": True}},
           "Web": {f"{HOST}:9443": {"Handlers": {"/": {"Proxy": "http://10.0.0.1:80"}}}}}
    check(KD.home_route(st2, 9443) is None, "unit: home_route won't claim someone else's route on 9443")
    check(KD.orphan_routes(st, set(), {}) == ([], []),
          "unit: reap's orphan sweep never touches a route the ledger doesn't list")
    same = {"TCP": {"9443": {"HTTPS": True}},
            "Web": {f"{HOST}:9443": {"Handlers": {"/": {"Proxy": "http://127.0.0.1:9443"}}}}}
    check(KD.route_ours(same, 9443), "unit: route_ours accepts the same-port home route")
    check(not KD.route_ours(dict(same, AllowFunnel={f"{HOST}:9443": True}), 9443),
          "unit: route_ours refuses the home route once Funnel is on for it")
    check(KD.route_ours(dict(same, AllowFunnel={f"{HOST}:443": True}), 9443),
          "unit: Funnel on another port doesn't count")
    form = KD.render_form("name", "a note", "/t")
    entry = KD.render_entry("/t", "csrf")   # the vault's add page, reached from "Add a credential"
    for what, html in (("home add page", entry), ("one-shot form", form)):
        check('autocomplete="new-password"' in html and "data-1p-ignore" in html,
              f"unit: the {what}'s password field asks managers not to save it")


