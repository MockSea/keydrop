def free_port():
    """A loopback port outside the ephemeral range (as 9443 is), free now."""
    import socket
    for p in range(40000 + secrets.randbelow(8000), 49000):
        s = socket.socket()
        try:
            s.bind(("127.0.0.1", p))
            return p
        except OSError:
            continue
        finally:
            s.close()
    raise SystemExit("no free port for the test home page")


os.environ["KEYDROP_HOME_PORT"] = str(free_port())

sys.dont_write_bytecode = True   # 3.14 would cache the extensionless tool in a __pycache__ beside it
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
loader = importlib.machinery.SourceFileLoader("keydrop", TOOL)
spec = importlib.util.spec_from_loader(loader.name, loader)
KD = importlib.util.module_from_spec(spec)
loader.exec_module(KD)
# The one guard everything else rests on: never the real keychain or tailscale.
assert KD.SECURITY == FAKE_SECURITY and KD.TAILSCALE == STUB and KD.OWNER_LOGIN == OWNER, \
    "refusing to run against the real keychain or tailnet"

FAILS, MADE, OUTSIDE, VALUES, TOKENS, BODIES = [], set(), [], [], [], []
# The owner's browser: their login (serve sets it) and the Fetch Metadata an HTTPS
# page gets from any current browser. Strikes need both.
LOGIN = {"Tailscale-User-Login": KD.OWNER_LOGIN, "Sec-Fetch-Site": "same-origin"}
FORM = {"Content-Type": "application/x-www-form-urlencoded"}


