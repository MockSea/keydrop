def test_strangers_cant_lock(page, token):
    """Finding 1. serve overwrites Tailscale-User-Login from WhoIs, so a
    request that doesn't carry the owner's login can never get in; counting it only
    hands every other tailnet node a way to lock the page.
    Every stranger request here also claims Sec-Fetch-Site: same-origin:
    a peer with curl can send any Fetch Metadata it likes, so the login
    check has to hold on its own, not behind the Fetch Metadata gate."""
    before = strikes()
    fm = "Sec-Fetch-Site: same-origin\r\n"
    variants = (("wrong login", fm + "Tailscale-User-Login: x@example.com\r\n"),
                ("no login", fm),
                ("underscore only", fm + f"Tailscale_User_Login: {KD.OWNER_LOGIN}\r\n"),
                ("doubled", fm + f"Tailscale-User-Login: {KD.OWNER_LOGIN}\r\nTailscale-User-Login: x@example.com\r\n"))
    for label, hs in variants:
        heads = [raw_get(page.port, t, hs) for t in (token, "nope", secrets.token_urlsafe(32))
                 for _ in range(2)]
        check(all(" 404 " in h for h in heads), f"stranger ({label}), any path: 404")
    for method in ("HEAD", "PUT", "DELETE", "OPTIONS"):
        heads = [raw_get(page.port, "nope", fm + "Tailscale-User-Login: x@example.com\r\n", method)
                 for _ in range(2)]
        check(all(" 404 " in h for h in heads), f"stranger {method}: 404")
    n = name("stranger")
    code = None
    for _ in range(KD.MAX_BAD + 1):
        try:
            code, _ = post(page.url(token), {"action": "add", "name": n, "value": value()},
                           {"Tailscale-User-Login": "x@example.com", "Sec-Fetch-Site": "same-origin"},
                           login=False)
        except (urllib.error.URLError, ConnectionError):
            code = "refused"
    check(code == 404 and KD.keychain_get(n) is None, "stranger POSTs: 404, nothing stored")
    check(strikes() == before and not KD.read_home().get("locked") and page.proc.poll() is None,
          f"{len(variants) * 6 + 8 + KD.MAX_BAD + 1} stranger requests: no strikes, no lock, page up")
    if page.proc.poll() is not None or KD.read_home().get("locked"):
        check(False, "page locked during the stranger flood; skipping the rest")
        unlock()
        return
    code, _ = get(page.url(token))
    check(code == 200, "the owner still gets in after the stranger flood")
    code, _ = get(page.url("nope"))
    check(code == 404 and strikes() == before + 1, "the owner's login with a wrong path token still counts")
    raw_get(page.port, "nope", f"Tailscale-User-Login: {KD.OWNER_LOGIN}\r\nSec-Fetch-Site: same-origin\r\n", "PUT")
    check(strikes() == before + 2, "the owner's login with an unsupported method still counts")
    unlock()


