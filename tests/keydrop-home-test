def test_route_check_home(token):
    """The page reads serve status on every request, before the gate. The
    idle watchdog runs at its full 10s here, and the route is dropped right
    after a tick, so the page is demonstrably still up when the request
    lands: only the per-request check can be what refuses it."""
    unlock()
    cases = (("removed", lambda st: {}, None),
             ("repointed", lambda st: dict(st, Web={f"{HOST}:{KD.HOME_PORT}": {"Handlers": {"/": {
                 "Proxy": f"http://127.0.0.1:{KD.HOME_PORT + 1}"}}}}), None),
             ("status garbled", lambda st: st, "{not json"),
             ("status unreadable", lambda st: st, "fail"))
    for label, change, garble in cases:
        page = Page()
        check(page.port is not None and get(page.url(token))[0] == 200, f"route check, {label}: page up, the owner gets in")
        before = strikes()
        with open(SERVE_JSON, "w") as f:
            json.dump(change(serve_cfg()), f)
        set_garble(garble)
        time.sleep(1.5)
        check(page.proc.poll() is None and accepts(KD.HOME_PORT),
              f"route check, {label}: still listening 1.5s on (the watchdog hasn't caught it)")
        code, body = get(page.url(token), {"Host": f"{HOST}:{KD.HOME_PORT}"})
        rc = page.wait(3)
        err = page.proc.stderr.read() if rc is not None else ""
        check(code == 404 and body == "", f"route check, {label}: the owner's login, right Host and token: bare 404 ({code})")
        check(rc == 1 and "went away" in err, f"route check, {label}: the page exits 1 right after ({rc})")
        check(not accepts(KD.HOME_PORT), f"route check, {label}: nothing listens after")
        check(strikes() == before, f"route check, {label}: no strike")
        check("route-gone" in outcomes(KD.HOME)[-2:], f"route check, {label}: log: route-gone ({outcomes(KD.HOME)[-2:]})")
        if label == "repointed":
            check(home_proxy() == f"http://127.0.0.1:{KD.HOME_PORT + 1}",
                  "route check, repointed: teardown leaves someone else's route alone")
        if garble:   # it couldn't see the route, so it tried to remove it and kept the record
            check(outcomes(KD.HOME)[-1:] == ["teardown-failed"] and route_up() is False
                  and any(r.get("kind") == "home" and r.get("teardown_failed") for r in KD.read_pending()),
                  f"route check, {label}: teardown still ran and kept its record for the reap")
        page.kill()
        set_garble(None)
        run("status")   # reap: retries a teardown the garbled status made fail
        if route_up():
            run("home", "--stop", "--force")
            unlock()
        check(not route_up() and not any(r.get("kind") == "home" for r in KD.read_pending()),
              f"route check, {label}: no route and no record left")
    unlock()


def home_proxy():
