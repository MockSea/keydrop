        while time.time() < end and KD.alive(rec["pid"]):
            time.sleep(0.05)
        check(not KD.alive(rec["pid"]) and outcomes(KD.VAULT)[-1:] == ["route-gone"],
              "route check, vault: the session ends, log route-gone")
        check(not any(x.get("kind") == "vault" for x in KD.read_pending()), "route check, vault: record dropped")


def make_outside_item():
    n = f"kdtest-outside-{secrets.token_hex(3)}"
    subprocess.run([FAKE_SECURITY, "add-generic-password", "-a", KD.ACCOUNT, "-s", n,
                    "-w", "not-a-secret"], check=True, capture_output=True)
    OUTSIDE.append(n)
    return n


def outside_exists(n):
    return subprocess.run([FAKE_SECURITY, "find-generic-password", "-a", KD.ACCOUNT, "-s", n],
                          capture_output=True).returncode == 0


def test_nothing_leaked():
    blobs = {"keydrop.log": "\n".join(log_lines(KD.LOG_FILE)),
             "home-audit.log": "\n".join(log_lines(KD.AUDIT_FILE)),
             "tailscale argv": "\n".join(log_lines(ARGV_LOG))}
    for v in VALUES:
        # The random core alone, plus the whole value raw, HTML-escaped and
        # hex: an escaped or partial leak still trips one of them.
        forms = (v, html.escape(v), v.encode().hex(), v.split(" & ")[1].split(" ")[0])
        check(not any(f in b for f in forms for b in BODIES), f"no response body holds value {forms[3][:6]}")
        for label, blob in blobs.items():
            check(not any(f in blob for f in forms), f"{label} free of value {forms[3][:6]}")
        check(not any(state_contains(f) for f in forms), f"state dir free of value {forms[3][:6]}")
    for t in TOKENS:
        for label, blob in blobs.items():
            check(t not in blob, f"{label} free of the link token")
        check(not state_contains(t), "state dir free of the link token")
    check("funnel" not in blobs["tailscale argv"], "never funnel")
    check(oct(os.stat(KD.HOME_FILE).st_mode & 0o777) == "0o600", "home.json is 0600")


def cleanup():
    for n in MADE:
        subprocess.run([FAKE_SECURITY, "delete-generic-password", "-a", KD.ACCOUNT,
                        "-s", KD.service(n)], capture_output=True)
    check(not [n for n in KD.keychain_list() if n in MADE], "all test-home-* entries deleted")
    for n in OUTSIDE:
        subprocess.run([FAKE_SECURITY, "delete-generic-password", "-a", KD.ACCOUNT, "-s", n],
                       capture_output=True)
    check(not any(outside_exists(n) for n in OUTSIDE), "kdtest-outside-* item deleted")


def main():
    make_stub()
    page = None
    try:
        test_units()
        test_no_link_yet()
        token = test_new_link()
        page = Page()
        check(page.port is not None and route_up(), "home starts and serve has :%d" % KD.HOME_PORT)
        proxy = serve_cfg()["Web"][f"{HOST}:{KD.HOME_PORT}"]["Handlers"]["/"]["Proxy"]
        check(page.port == KD.HOME_PORT and proxy == f"http://127.0.0.1:{KD.HOME_PORT}",
              "the route proxies to 127.0.0.1 on the same port it claims")
        test_same_port(page)
        check(run("home").returncode != 0, "a second `keydrop home` is refused")
        check("[home]\talways on" in run("status").stdout, "status lists the home page")
        test_header_spoofs(page, token)
        page = restart(page)
        test_strangers_cant_lock(page, token)
        page = restart(page)
        test_csrf(page, token)
        page = test_stale_after_restart(page, token)
        page = restart(page)
        test_fetch_metadata(page, token)
        page = restart(page)
        test_peer_flood(page, token)
        page = restart(page)
        test_rebinding(page, token)
        page = restart(page)    # the per-minute request cap is per process
        test_writes(page, token)
        page = restart(page)
        test_typed_home(page, token)
        page = restart(page)
        test_flood(page, token)
        page = restart(page)
        page = test_rate_limit(page, token)
        page = test_lockout(page, token)
        token = test_new_link_replaces(page, token)
        test_stop(page, token)
        page = None
        test_stop_flag_ends_loop(token)
        test_stop_race(token)
