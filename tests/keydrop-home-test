def test_stop_race(token):
    """Finding 2, the start-up half. --stop lands while `keydrop home` is past
    its start-up flag check but hasn't routed yet. --stop must not be a lie:
    the page must not come up afterwards."""
    unlock()
    for f in (SLOW, STALLING):
        if os.path.exists(f):
            os.unlink(f)
    open(SLOW, "w").close()
    proc = subprocess.Popen([TOOL, "home"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    end = time.time() + 10
    while time.time() < end and not os.path.exists(STALLING):
        time.sleep(0.02)
    check(os.path.exists(STALLING) and proc.poll() is None, "race: home is stalled inside start-up")
    r = run("home", "--stop", "--force")
    check(r.returncode == 0, "race: --stop reports the page stopped")
    seen = len(log_lines(ARGV_LOG))
    try:
        rc = proc.wait(15)
    except subprocess.TimeoutExpired:
        rc = None
    up = route_up()
    if rc is None:
        proc.send_signal(signal.SIGTERM)
        proc.wait(15)
    check(rc == 0, f"race: the page exits 0 instead of serving after --stop (rc={rc})")
    check(not up, "race: no route after --stop")
    later = [json.loads(l) for l in log_lines(ARGV_LOG)[seen:]]
    check(not [a for a in later if a[:2] == ["serve", "--bg"]],
          "race: the page never puts a route up after --stop (not even briefly)")
    check(log_lines(KD.LOG_FILE)[-1:] and log_lines(KD.LOG_FILE)[-1].endswith("refused (stopped)"),
          "race: the page logs that it refused to start")
    check(not [x for x in KD.read_pending() if x.get("kind") == "home"], "race: no record left")
    check(KD.read_home().get("stopped"), "race: still flagged stopped")
    unlock()


