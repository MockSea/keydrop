def iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch)) if epoch else "-"


def when(epoch):
    return time.strftime("%b %-d, %Y · %H:%M", time.localtime(epoch)) if epoch else "?"


def read_activity():
    events = []
    try:
        with open(LOG_FILE, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 65536))
            lines = f.read().decode("utf-8", "replace").splitlines()
        for line in lines:
            parts = line.split("\t")
            if len(parts) == 3 and (valid_name(parts[1]) or parts[1] in (HOME, VAULT)):
                events.append(parts)
    except OSError:
        pass
    return events[-100:][::-1]


def render_vault(action, csrf, entries, notes, expires, flash="", error="",
                 title="keydrop vault", done_label="Done, close this link", query="", status="all"):
    metadata = read_items()
    today = time.strftime("%Y-%m-%d")
    overdue = lambda n: bool(metadata.get(n, {}).get("rotate_by") and metadata[n]["rotate_by"] < today)
    rows = []
    for name in sorted(entries):
        if query.lower() not in (name + " " + notes.get(name, "") + " " + (metadata.get(name, {}).get("schema") or {}).get("service", "")).lower():
            continue
        if status == "overdue" and not overdue(name):
            continue
        e, hname = entries[name], html.escape(name)
        date = metadata.get(name, {}).get("rotate_by", "")
        schema = metadata.get(name, {}).get("schema")
        description = (schema["service"] + " · " + str(len(schema["fields"])) + " fields") if schema else e.get("type", "secret")
        age = str(max(0, int((time.time() - e["updated"]) / 86400))) + "d" if e.get("updated") else "Unknown"
        rows.append('<tr><td><b>' + hname + '</b><p class="meta">' + html.escape(notes.get(name, "")) + '</p><span class="meta">' + html.escape(description) + '</span></td>'
            + f'<td data-label="Created">{when(e.get("created"))}</td><td data-label="Updated">{when(e.get("updated"))}<p class="meta">Age {age}</p></td>'
            + '<td><span class="badge' + (' overdue' if overdue(name) else '') + '">' + ('Overdue · ' if overdue(name) else 'Rotate by · ' if date else '') + html.escape(date or 'No schedule') + '</span></td>'
            + '<td><div class="row-actions">' + vault_form(action, csrf, "rotate-form", hidden("name", name), "Rotate", "quiet")
            + vault_form(action, csrf, "delete", hidden("name", name), "Delete…", "quiet") + '</div></td></tr>')
    lifetime = f'Link ends {time.strftime("%H:%M", time.localtime(expires))}.' if expires else "This page stays up until you stop it."
    toolbar = '<label>Search names, notes or services<input name="query" value="' + html.escape(query) + '" placeholder="Search credentials"></label><label>Schedule<select name="status"><option value="all">All keys</option><option value="overdue"' + (' selected' if status == 'overdue' else '') + '>Overdue</option></select></label>'
    body = '<p class="meta">' + html.escape(title) + ' / VAULT</p><h1>Credentials</h1><p>Manage access. Keep secrets out of sight.</p>'
    body += '<div class="metrics"><span><strong>' + str(len(entries)) + '</strong>keys</span><span><strong>' + str(sum(overdue(n) for n in entries)) + '</strong>overdue</span></div>'
    body += (f'<p class="ok" role="status">{html.escape(flash)}</p>' if flash else '') + (f'<p class="err" role="alert">{html.escape(error)}</p>' if error else '')
    body += vault_form(action, csrf, "search", '<div class="toolbar">' + toolbar + '</div>', "Filter", "quiet")
    body += '<table><thead><tr><th>Name / note</th><th>Created</th><th>Updated / age</th><th>Rotation</th><th>Actions</th></tr></thead><tbody>' + (''.join(rows) or '<tr><td>No matching keys. Add your first credential below.</td></tr>') + '</tbody></table>'
    body += '<h2>Add a credential</h2>' + vault_form(action, csrf, "new", '<label>Proposed template</label><select name="template"><option value="">Single secret</option>' + ''.join('<option>' + t + '</option>' for t in (TEMPLATES if credentials_enabled() else [])) + '</select>', "Continue")
    body += '<details><summary>Activity · recent outcomes</summary><p class="meta">Names, times and outcomes only. Latest 100 events.</p><table><thead><tr><th>Time</th><th>Name</th><th>Outcome</th></tr></thead><tbody>' + ''.join('<tr>' + ''.join('<td>' + html.escape(v) + '</td>' for v in ev) + '</tr>' for ev in read_activity()) + '</tbody></table></details>'
    body += f'<p class="meta">{lifetime} Values are write-only here.</p>' + vault_form(action, csrf, "done", "", done_label, "quiet")
    return PAGE.format(body=body)


