# Discourage the browser and password managers from offering to save the
# value: new-password stops autofill of an old one and makes most browsers
# treat it as a sign-up field; the data-* attributes are 1Password's,
# LastPass's and Bitwarden's opt-outs. None of it is a guarantee, so the
# skill tells the human to answer "Never" if a save prompt appears anyway.
NO_SAVE = ('autocomplete="new-password" autocapitalize="off" autocorrect="off" '
           'spellcheck="false" data-1p-ignore data-lpignore="true" data-bwignore '
           'data-form-type="other"')


def hidden(name, value):
    return f'<input type="hidden" name="{html.escape(name)}" value="{html.escape(value)}">'


def credential_inputs(schema, focus=False):
    if not schema:
        return ('<label for="value">Secret value</label><input id="value" type="password" name="value" '
                + NO_SAVE + (' autofocus' if focus else '') + ' required>')
    out = hidden("schema", json.dumps(schema))
    for i, f in enumerate(schema["fields"]):
        ident = "f_" + f["name"]
        out += f'<label for="{ident}">{html.escape(f["label"])}' + ("" if f["required"] else " (optional)") + '</label>'
        req = (" autofocus" if focus and i == 0 else "") + (" required" if f["required"] else "")
        if f["kind"] == "select":
            out += f'<select id="{ident}" name="{ident}"{req}><option value="">Choose…</option>'
            out += ''.join(f'<option>{html.escape(v)}</option>' for v in f["options"]) + '</select>'
        else:
            kind = {"secret": "password", "text": "text", "url": "url"}[f["kind"]]
            attrs = NO_SAVE if kind == "password" else NO_SAVE.replace('new-password', 'off')
            out += f'<input id="{ident}" name="{ident}" type="{kind}" {attrs} maxlength="{f["max"]}"{req}>'
    return out


def render_form(name, note, action, error="", schema=None, expires=None):
    body = (f'<div class="entry"><p class="meta">CREDENTIAL REQUEST</p><h1>{html.escape(name)}</h1>'
            + (f"<p>{html.escape(note)}</p>" if note else "")
            + '<p>It goes straight into the vault. Stored values never appear on this page.</p>'
            + (f'<p class="err">{html.escape(error)}</p>' if error else "")
            + f'<form method="post" action="{html.escape(action)}" autocomplete="off">'
            + credential_inputs(schema, focus=True) + '<button type="submit">Store</button></form>')
    if expires:
        body += '<p class="meta">Link ends ' + time.strftime("%H:%M", time.localtime(expires)) + '.</p>'
    body += schema_editor(action, "", name, schema, request=True) + '</div>'
    return PAGE.format(body=body)


def schema_editor(action, csrf, name, schema, request=False, act="add"):
    if not credentials_enabled():
        return '<p class="meta">Additional credential types are disabled by this vault’s policy.</p>'
    schema = schema or {"service": "generic", "fields": [schema_field("value")]}
    out = '<details><summary>Edit proposed fields</summary><p>Definitions only. Remove a field by clearing its name. Add fields in the empty rows. Applying changes clears entered values.</p>'
    controls = hidden("name", name) + hidden("target", act)
    controls += '<label>Service</label><input name="service" value="' + html.escape(schema["service"]) + '" required>'
    for i in range(FIELD_LIMIT):
        f = schema["fields"][i] if i < len(schema["fields"]) else {}
        if not f:
            controls += '<details><summary>Add another field</summary>'
        controls += hidden(f"m{i}", str(f.get("max", 8192)))
        controls += f'<div class="field-row"><div class="field-grid"><div><label>Field {i+1} · name</label><input name="n{i}" value="{html.escape(f.get("name", ""))}" maxlength="32"></div>'
        controls += f'<div><label>Label</label><input name="l{i}" value="{html.escape(f.get("label", ""))}" maxlength="80"></div></div>'
        controls += f'<label>Kind</label><select name="k{i}">' + ''.join(f'<option{(" selected" if k == f.get("kind", "secret") else "")}>{k}</option>' for k in ("secret", "text", "url", "select")) + '</select>'
        controls += f'<label><input type="checkbox" name="r{i}" value="yes"' + (' checked' if f.get("required", True) else '') + '> Required</label>'
        controls += f'<label>Select options (one per comma)</label><input name="o{i}" value="{html.escape(",".join(f.get("options", [])))}"></div>'
        if not f:
            controls += '</details>'
    if request:
        out += f'<form method="post" action="{html.escape(action)}" autocomplete="off">' + hidden("action", "edit-schema") + controls + '<button>Apply fields</button></form>'
    else:
        out += vault_form(action, csrf, "edit-schema", controls, "Apply fields")
    return out + '</details>'


def schema_from_editor(fields):
    if any(len(v) != 1 for v in fields.values()):
        raise KeydropError("Invalid credential schema.")
    fs = []
    for i in range(FIELD_LIMIT):
        name = field(fields, f"n{i}")
        if not name:
            continue
        f = dict(name=name, label=field(fields, f"l{i}"), kind=field(fields, f"k{i}"), required=field(fields, f"r{i}") == "yes")
        if f["kind"] == "select":
            f["options"] = field(fields, f"o{i}").split(",")
        try:
            f["max"] = int(field(fields, f"m{i}") or "8192")
        except ValueError:
            raise KeydropError("Invalid credential schema.")
        fs.append(f)
    schema = validate_schema({"service": field(fields, "service"), "fields": fs})
    check_policy(schema)
    return schema


def render_entry(action, csrf, name="", schema=None, act="add", rotate_by=""):
    title = "Rotate " + name if act == "rotate" else "Add a credential"
    fields = (hidden("name", name) if name else '<label>Name</label><input name="name" required pattern="[a-z0-9._-]{1,64}" maxlength="64">')
    fields += '<label>Note · never put secrets here</label><input name="note" maxlength="200">'
    fields += '<label>Rotate by (optional)</label><input type="date" name="rotate_by" value="' + html.escape(rotate_by) + '">' + credential_inputs(schema)
    return PAGE.format(body='<div class="entry"><p class="meta">KEY MANAGEMENT</p><h1>' + html.escape(title) + '</h1><p>Rotation replaces the complete credential. Update the service first, then store all new fields here.</p>'
        + vault_form(action, csrf, act, fields, "Rotate credential" if act == "rotate" else "Store")
        + schema_editor(action, csrf, name, schema, act=act) + vault_form(action, csrf, "back", "", "Back", "quiet") + '</div>')


