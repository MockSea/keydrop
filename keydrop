# ---------- server ----------

def token_matches(path, token):
    """Constant-time: compare fixed-length digests, so neither content nor
    length of a wrong guess changes the timing."""
    guess = path[1:] if path.startswith("/") else path
    return hmac.compare_digest(hashlib.sha256(guess.encode("utf-8", "replace")).digest(),
                               hashlib.sha256(token.encode()).digest())


def login_ok(headers):
    """Exactly one login header, spelled exactly, naming the owner. `headers` is an
    email.message.Message: names compare case-insensitively, so 'exactly'
    here means no underscore or other variant that some proxy might fold
    into the real one."""
    lookalike = [k for k in headers.keys()
                 if re.sub(r"[^a-z]", "", k.lower()) == "tailscaleuserlogin"]
    values = headers.get_all(LOGIN_HEADER) or []
    if not OWNER_LOGIN:   # unconfigured: nobody matches, never everybody
        return False
    if len(lookalike) != 1 or len(values) != 1 or lookalike[0].lower() != LOGIN_HEADER.lower():
        return False
    return hmac.compare_digest(values[0].strip().lower().encode("utf-8", "replace"),
                               OWNER_LOGIN.encode())


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "keydrop"
    sys_version = ""
    timeout = REQUEST_TIMEOUT

    def log_message(self, *args):
        pass   # the default request log line contains the token

    def _send(self, code, body=b"", ctype="text/html; charset=utf-8", extra=()):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; "
                         "frame-ancestors 'none'; base-uri 'none'")
        for k, v in extra:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _not_found(self, path):
        if not path.startswith(AUTO_FETCH) and self._strike_eligible():
            self.server.bad += 1
        self._send(404, b"", "text/plain")

    def _strike_eligible(self):
        """Whether a failure from this request counts toward the lockout."""
        return True

    def _admitted(self):
        """A check between the login pin and the token; False means it has
        already answered. Nothing here for short-lived pages."""
        return True

    def _route_gone(self):
        """First thing on every request, before the Host allowlist and the
        login pin: is serve still claiming this port? If not, the request may
        have come straight from netstack with forged identity headers, so it
        gets a bare 404 and the page ends (route-gone). The serve loop stops
        once this response is written. True means it has already answered."""
        if self.server.route_intact():
            return False
        self._send(404, b"", "text/plain")
        self.server.outcome = "route-gone"
        return True

    def _turned_away(self):
        """A pre-gate refusal on top of the Host allowlist; none here."""
        return False

    def _screened(self):
        """The checks that answer before anything is charged or struck. True
        means the request has already been answered."""
        return self._route_gone() or self._turned_away() or self._host_refused()

    def _host_refused(self):
        """The Host allowlist, before anything else: a refusal is a bare 404,
        not charged to any budget, not a strike, logged only within the
        capped refusal bucket. True means it has already answered."""
        if self.server.host_allowed(self.headers.get_all("Host") or []):
            return False
        if self.server.may_log_refusal():
            log(self.server.name, "refused: host")
        self._send(404, b"", "text/plain")
        return True

    def _login_passes(self, path):
        """The login pin, if this server has one. A failure is answered here
        (a bare 404, via _login_refused) and logged."""
        if not self.server.pin or login_ok(self.headers):
            return True
        if not path.startswith(AUTO_FETCH) and self.server.may_log_refusal():
            log(self.server.name, "refused: login")
        self._login_refused(path)
        return False

    def _login_refused(self, path):
        """Short-lived pages count a refused login toward the lockout."""
        self._not_found(path)

    def _authorised(self):
        """The login pin first, then the token. Both failures look the same
        from outside (a bare 404)."""
        if self._screened():
            return None
        self.server.requests += 1
        path = urllib.parse.urlsplit(self.path).path
        if not self._login_passes(path) or not self._admitted():
            return None
        if self.server.token_ok(path):
            return path
        self._not_found(path)
        return None

    def _read_form(self, max_fields):
        """The parsed POST body, or None after sending a 400."""
        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            length = -1
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        if not 0 < length <= MAX_BODY or ctype != "application/x-www-form-urlencoded":
            self._send(400, render_message("That didn't look like the form.").encode())
            return None
        try:
            return urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8"),
                                         max_num_fields=max_fields, strict_parsing=True,
                                         keep_blank_values=True)
        except (UnicodeDecodeError, ValueError):
            self._send(400, render_message("That didn't look like the form.").encode())
            return None

    def do_GET(self):
        path = self._authorised()
        if path:
            self._send(200, render_form(self.server.name, self.server.note, path, schema=self.server.schema, expires=getattr(self.server, "expires", None)).encode())

    def do_POST(self):
        path = self._authorised()
        if not path:
            return
        fields = self._read_form(90)
        if fields is None:
            return
        proposal = self.server.schema
        try:
            if field(fields, "schema"):
                proposal = validate_schema(schema_json(field(fields, "schema")))
            if field(fields, "action") == "edit-schema":
                schema = schema_from_editor(fields)
                self._send(200, render_form(self.server.name, self.server.note, path, schema=schema, expires=getattr(self.server, "expires", None)).encode())
                return
            value, schema = submitted_item(fields, self.server.schema)
            if not STORE.fits(self.server.name, value, bool(schema)):
                raise KeydropError(TOO_LONG)
        except (KeydropError, ValueError) as e:
            message = str(e) if isinstance(e, KeydropError) else "Invalid credential schema."
            self._send(400, render_form(self.server.name, self.server.note, path, message, proposal, getattr(self.server, "expires", None)).encode())
            return
        try:
            STORE.store(self.server.name, value, typed=bool(schema))
            # A one-shot store keeps whatever rotate-by date the owner set.
            write_item_meta(self.server.name, schema,
                            read_items().get(self.server.name, {}).get("rotate_by", ""))
        except (KeydropError, OSError, subprocess.TimeoutExpired):
            self.server.outcome = "store-failed"
            self._send(500, render_message("Couldn't store it. Tell whoever sent you the link.").encode())
            return
        finally:
            value = fields = None
        if self.server.note:
            write_note(self.server.name, self.server.note)
        self.server.outcome = "stored"
        self._send(200, render_message("Stored. You can close this.").encode())

    def _reject(self):
        if self._screened():
            return
        self.server.requests += 1
        self._not_found(urllib.parse.urlsplit(self.path).path)

    do_HEAD = do_PUT = do_DELETE = do_PATCH = do_OPTIONS = _reject


def field(fields, key):
    return (fields.get(key) or [""])[0]


class VaultHandler(Handler):
    """GET shows the list. Every change is a POST to the same /<token> with
    the session's form token and an action; the response is a 303 back to the
    list, so a reload never resubmits a value."""

    def do_GET(self):
        path = self._authorised()
        if path:
            self._page(path)

    def _page(self, path, code=200, error="", query="", status="all"):
        srv = self.server
        flash, srv.flash = srv.flash, ""
        try:
            entries = STORE.list()
        except (KeydropError, OSError, subprocess.TimeoutExpired):
            entries, error = {}, error or "Couldn't read the keychain."
        self._send(code, render_vault(path, srv.issue_csrf(), entries, read_notes(), srv.expires,
                                      flash, error, srv.title, srv.done_label, query, status).encode())

    def _done(self, path, flash):
        self.server.flash = flash
        self._send(303, b"", "text/plain", extra=(("Location", path),))

    def _origin_ok(self):
        """Pages here send no referrer, so a browser's own same-origin POST
        carries `Origin: null` (or none). A real origin is only accepted if it
        names the host the request was sent to; anything else is another
        site's page posting here."""
        origins = self.headers.get_all("Origin") or []
        if len(origins) > 1:
            return False
        if not origins or origins[0].strip() == "null":
            return True
        host = (self.headers.get("Host") or "").strip().lower()
        return bool(host) and urllib.parse.urlsplit(origins[0].strip()).netloc.lower() == host

    def _csrf_check(self, fields):
        """"ok", "stale" (a real form token that has aged out; not counted)
        or "bad". Sec-Fetch-Site and Origin are second opinions where the
        browser sends them."""
        site = (self.headers.get("Sec-Fetch-Site") or "same-origin").lower()
        if site not in ("same-origin", "none") or not self._origin_ok():
            return "bad"
        return self.server.check_csrf(field(fields, "csrf"))

    def do_POST(self):
        path = self._authorised()
        if not path:
            return
        fields = self._read_form(90)
        if fields is None:
            return
        try:
            verdict = self._csrf_check(fields)
            if verdict != "ok":
                if verdict == "bad":
                    if not self._strike_eligible():
                        self._send(404, b"", "text/plain")
                        return
                    self.server.bad += 1
                log(self.server.name, f"refused: form token ({verdict})")
                self._send(403, render_message("That form is stale. Reload the page.").encode())
                return
            self._act(path, field(fields, "action"), fields)
        finally:
            fields = None

    def _act(self, path, act, fields):
        if act in ("search", "new", "edit-schema", "rotate-form"):
            try:
                if act == "search":
                    self._page(path, query=field(fields, "query")[:200], status=field(fields, "status"))
                    return
                name = field(fields, "name")
                target = field(fields, "target") or "add"
                schema = None
                if act == "new":
                    template = field(fields, "template")
                    schema = template_schema(template) if template else None
                    name, target = "", "add"
                elif act == "edit-schema":
                    schema = schema_from_editor(fields)
                    if target not in ("add", "rotate") or (name and not valid_name(name)):
                        raise KeydropError("Invalid item.")
                else:
                    if not valid_name(name) or not STORE.exists(name):
                        raise KeydropError("Item no longer exists.")
                    schema = read_items().get(name, {}).get("schema")
                    target = "rotate"
                check_policy(schema)
                rotate_by = read_items().get(name, {}).get("rotate_by", "") if target == "rotate" else ""
                self._send(200, render_entry(path, self.server.issue_csrf(), name, schema, target, rotate_by).encode())
            except (KeydropError, OSError, subprocess.TimeoutExpired) as e:
                self._page(path, 400, str(e) if isinstance(e, KeydropError) else "Couldn't read the keychain.")
            return
        name = field(fields, "name").strip()
        if act == "done":
            self.server.outcome = self.server.done_outcome
            self._send(200, render_message(self.server.done_message).encode())
            return
        if act == "back":
            self._done(path, "")
            return
        if act not in ("add", "replace", "rotate", "delete", "delete-confirm"):
            self._page(path, 400, "Unknown action.")
            return
        if not valid_name(name):
            self._page(path, 400, "Names are a-z, 0-9, . _ - and up to 64 characters.")
            return
        try:
            exists = STORE.exists(name)
        except (OSError, subprocess.TimeoutExpired):
            self._page(path, 500, "Couldn't read the keychain.")
            return
        if act == "add" and exists:
            self._page(path, 409, f"{name} already exists. Use Replace on it instead.")
            return
        if act != "add" and not exists:
            self._page(path, 404, f"There's no {name}.")
            return
        if act == "delete":
            self._send(200, render_confirm_delete(path, self.server.issue_csrf(), name).encode())
            return
        if act == "delete-confirm":
            self._delete(path, name)
            return
        self._store(path, act, name, fields)

    def _rate_limited(self, path, name, act):
        """Booked only once a write is about to happen, so a refused form
        doesn't use up a slot."""
        if self.server.write_allowed():
            return False
        self.server.audit(name, f"{act} rate-limited")
        self._page(path, 429, "Too many changes in the last hour. Try again later.")
        return True

    def _delete(self, path, name):
        if self._rate_limited(path, name, "delete"):
            return
        try:
            STORE.delete(name)
        except (KeydropError, OSError, subprocess.TimeoutExpired):
            self.server.audit(name, "delete failed")
            self._page(path, 500, f"Couldn't delete {name}.")
            return
        write_note(name, None)
        write_item_meta(name, None, None)
        self.server.audit(name, "deleted")
        self._done(path, f"Deleted {name}.")

    def _store(self, path, act, name, fields):
        try:
            note = clean_note(field(fields, "note"))
        except KeydropError as e:
            self._page(path, 400, str(e).replace("--note", "The note"))
            return
        try:
            previous = read_items().get(name, {})
            value, schema = submitted_item(fields, previous.get("schema") if act != "add" else None)
            rotate_by = rotation_date(field(fields, "rotate_by")) if "rotate_by" in fields else previous.get("rotate_by", "")
            if not STORE.fits(name, value, bool(schema)):
                raise KeydropError(TOO_LONG)
        except (KeydropError, ValueError) as e:
            self._page(path, 400, str(e) if isinstance(e, KeydropError) else "Invalid field.")
            return
        if self._rate_limited(path, name, act):
            return
        try:
            STORE.store(name, value, typed=bool(schema))
            write_item_meta(name, schema, rotate_by)
        except (KeydropError, OSError, subprocess.TimeoutExpired):
            self.server.audit(name, f"{act} failed")
            self._page(path, 500, f"Couldn't store {name}.")
            return
        finally:
            value = None
            fields.pop("value", None)
        if note or act == "add":
            write_note(name, note or None)
        self.server.audit(name, f"{act} stored")
        self._done(path, f"Stored {name}.")


class Server(http.server.HTTPServer):
    max_requests = MAX_REQUESTS

    def __init__(self, handler, token, name, note="", pin=True, port=0):
        # Bound, not listening: serve_child calls listen() once the route
        # claims this port. Until then a SYN to it is dropped.
        super().__init__(("127.0.0.1", port), handler, bind_and_activate=False)
        try:
            self.server_bind()
        except OSError as e:
            self.server_close()
            raise KeydropError(f"127.0.0.1:{port} is already taken on this Mac ({e.strerror})")
        self.listening = False
        self.token, self.name, self.note, self.pin = token, name, note, pin
        self.bad = self.requests = 0
        self.outcome = None
        self.tailnet_port = None   # set by allow_hosts; None fails route_intact
        self.allow_hosts()

    def listen(self):
        self.server_activate()
        self.listening = True

    def watch(self):
        """An outcome to end the serve loop with, or None to carry on."""
        return None

    def allow_hosts(self, tailnet_name=None, tailnet_port=None):
        """The exact Host values this page answers: its loopback names on its
        own port, plus the tailnet name with and without the tailnet port
        (whether serve keeps the browser's Host or rewrites it to the
        backend). A DNS-rebinding page always carries its own hostname."""
        port = self.server_address[1]
        hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
        if tailnet_name:
            hosts |= {tailnet_name, f"{tailnet_name}:{tailnet_port}"}
            self.tailnet_port = tailnet_port
        self.hosts = frozenset(h.lower() for h in hosts)

    def route_intact(self, status=None):
        """Whether serve still claims this page's port with a route to this
        listener. A page with no tailnet port has nothing claiming it."""
        if self.tailnet_port is None or self.tailnet_port != self.server_address[1]:
            return False
        return route_ours(serve_status() if status is None else status, self.tailnet_port)

    def host_allowed(self, values):
        """Exactly one Host header, exactly one of ours. Anything else
        (missing, duplicated, another name or port) is refused."""
        return len(values) == 1 and values[0].lower() in self.hosts

    def token_ok(self, path):
        return token_matches(path, self.token)

    def refusal(self):
        """A reason not to start serving, checked under serve_lock right
        before the route goes up. None: go ahead."""
        return None

    def may_log_refusal(self):
        """Whether a refused login gets a log line. Short-lived pages die
        after a handful of failures, so always."""
        return True


class OneShot(Server):
    def __init__(self, token, name, note, pin=True, port=0, schema=None):
        super().__init__(Handler, token, name, note, pin, port)
        self.schema = schema


class Vault(Server):
    max_requests = MAX_SESSION_REQUESTS
    handler = VaultHandler
    title, done_label = "keydrop vault", "Done, close this link"
    done_outcome, done_message = "done", "Closed. The link is dead now."
    label = "vault"

    def __init__(self, token, expires, pin=True, name=VAULT, port=0):
        super().__init__(self.handler, token, name, "", pin, port)
        self.csrf = secrets.token_urlsafe(32)
        self.expires = expires
        self.flash = ""

    def issue_csrf(self):
        return self.csrf

    def check_csrf(self, given):
        same = hmac.compare_digest(hashlib.sha256(given.encode("utf-8", "replace")).digest(),
                                   hashlib.sha256(self.csrf.encode()).digest())
        return "ok" if same else "bad"

    def write_allowed(self):
        return True

    def audit(self, name, event):
        """Name and what happened. Never a value: no caller has one to pass."""
        log(name, f"{self.label} {event}")


def run_until_done(srv, deadline):
    srv.timeout = 0.5
    while srv.outcome is None:
        if time.time() >= deadline:
            return "expired"
        if srv.bad >= MAX_BAD or srv.requests >= srv.max_requests:
            return "locked-out"
        why = srv.watch()
        if why:
            return why
        srv.handle_request()
    return srv.outcome


class Terminated(BaseException):
    pass


class Refused(Exception):
    """The server's refusal() said no at the last moment before routing."""


def _on_signal(signum, _frame):
    raise Terminated(signal.Signals(signum).name)


def serve_child(srv, rec, report_fd):
    """Runs in the detached child. Owns teardown from the first line."""
    outcome = "crashed"
    serving = False
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, _on_signal)
    try:
        with serve_lock():
            write_pending(rec)   # before the route, so a route never exists unowned
            # Checked after the record is written, and under the lock
            # home_stop sets its flag under: a stop that lands during start-up
            # is either seen here, or finds this record and SIGTERMs us.
            why = srv.refusal()
            if why:
                raise Refused(why)
            if rec["tailnet_port"]:
                serving = True   # a timed-out `serve` may still have written config
                serve_on(rec["tailnet_port"], rec["local_port"], rec["plain_http"])
            srv.listen()   # only now: the route claims the port first
        log(rec["name"], "requested")
        os.write(report_fd, b"ok")
        os.close(report_fd)
        report_fd = None
        outcome = run_until_done(srv, rec["expires"] or float("inf"))
    except Terminated as e:
        outcome = f"cancelled ({e})"
    except Refused as e:
        outcome = f"refused ({e})"
    except KeydropError as e:
        outcome = "serve-failed"
        if report_fd is not None:
            os.write(report_fd, str(e).encode()[:1000])
    except Exception as e:   # noqa: BLE001 - last line before teardown
        outcome = f"crashed ({type(e).__name__})"
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        srv.server_close()
        log(rec["name"], outcome)
        with serve_lock():
            if serving and outcome == "route-gone" and route_left(rec["tailnet_port"]):
                drop_pending(rec)   # gone, or someone else's now: not ours to remove
                ledger_drop(rec["tailnet_port"])
            elif serving and not serve_off(rec["tailnet_port"], rec["plain_http"]):
                # Keep the record so reap retries; the route may still be live
                # or come back from tailscaled's persisted config.
                write_pending(dict(rec, teardown_failed=True))
                log(rec["name"], "teardown-failed")
            else:
                drop_pending(rec)
        if report_fd is not None:
            try:
                os.close(report_fd)
            except OSError:
                pass
    return outcome


def route_left(port):
    """After route-gone: True if serve status reads and :port is either absent
    or no longer ours, so teardown must not touch it. False (unreadable, or
    still ours) means tear down as usual, which keeps the record on failure."""
    st = serve_status()
    if st is None:
        return False
    try:
        return str(port) not in (st.get("TCP") or {}) or not route_ours(st, port)
    except (AttributeError, TypeError):
        return False


def detach_stdio(keep):
    """Point 0-2 at /dev/null and close every other inherited fd, so the
    child holds none of the caller's pipes open (a caller waiting for EOF
    would otherwise wait out the whole TTL)."""
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    os.close(devnull)
    lo = 3
    for fd in sorted(keep):
        os.closerange(lo, fd)
        lo = fd + 1
    os.closerange(lo, os.sysconf("SC_OPEN_MAX"))


def claim_port(make, in_use, tries=PORT_PICK_TRIES):
    """make() binds a server on a fresh loopback port. Keep the first one
    whose port serve isn't already using, so the tailnet route can take the
    same number; refuse rather than drift onto another one. Rejected binds
    are held until the end so the kernel can't hand the same port back."""
    rejected = []
    try:
        for _ in range(tries):
            srv = make()
            if str(srv.server_address[1]) not in in_use:
                return srv
            rejected.append(srv)
    finally:
        for srv in rejected:
            srv.server_close()
    raise KeydropError(f"no free loopback port serve isn't already using after {tries} tries")


def request_schema(name, typ=None, template=None, fields_arg=None, schema_path=None):
    """The field definition a `request` proposes, or None for a single secret.

    --type secret|credential is SPEC 6; --fields a,b picks credential's
    optional fields (SPEC 5.3). A JSON list in --fields, --schema and
    --template (or --type <template>) define other services' fields."""
    if not valid_name(name):
        raise RefusedError("name must be [a-z0-9._-], 1-64 chars")
    if template is not None and typ is not None:
        raise RefusedError("choose one of --type and --template")
    typ = typ if typ is not None else template
    json_fields = fields_arg is not None and fields_arg.lstrip().startswith("[")
    if fields_arg is not None and not json_fields:
        if typ not in (None, "credential") or schema_path is not None:
            raise RefusedError("--fields a,b goes with --type credential")
        return credential_schema(name, [f.strip() for f in fields_arg.split(",") if f.strip()])
    if sum(x is not None for x in (schema_path, typ, fields_arg)) > 1:
        raise RefusedError("choose one of --schema, --fields or --type")
    try:
        if schema_path is not None:
            with open(schema_path) as f:
                raw = f.read(16385)
            if len(raw) > 16384:
                raise ValueError()
            return validate_schema(schema_json(raw))
        if json_fields:
            return validate_schema({"service": name, "fields": schema_json(fields_arg)})
    except (OSError, ValueError):
        raise RefusedError("can't read a valid schema")
    if typ == "secret":
        return None
    if typ == "credential":
        return credential_schema(name)
    if typ is not None:
        if typ not in TEMPLATES:
            raise RefusedError(f"unknown type {typ!r} (secret, credential or one of: {', '.join(TEMPLATES)})")
        return template_schema(typ)
    # A bare name that matches a multi-field template proposes it, but only
    # where credentials are on: elsewhere `request <name>` stays the plain
    # secret it always was, and so does `get <name>`.
    if name in TEMPLATES and len(TEMPLATES[name]) > 1 and credentials_enabled():
        return template_schema(name)
    return None


def request(name, note, ttl, plain_http=False, schema=None):
    schema = validate_schema(schema) if schema else None
    check_policy(schema)
    if not valid_name(name):
        raise KeydropError("name must be [a-z0-9._-], 1-64 chars")
    note = clean_note(note)
    ensure_state()
    reap()
    if any(r["name"] == name and not r.get("teardown_failed") for r in read_pending()):
        raise KeydropError(f"a request for {name} is already pending (keydrop cancel {name})")
    host = tailnet_host(plain_http)
    token = secrets.token_urlsafe(32)
    srv = claim_port(lambda: OneShot(token, name, note, True, schema=schema), serve_ports_in_use())
    srv.expires = time.time() + ttl
    return launch(srv, token, {"name": name, "note": note}, ttl, host, plain_http)


def vault(ttl, plain_http=False):
    ensure_state()
    reap()
    if any(r.get("kind") == "vault" and not r.get("teardown_failed") for r in read_pending()):
        raise KeydropError("a vault session is already open (keydrop cancel vault)")
    host = tailnet_host(plain_http)
    token = secrets.token_urlsafe(32)
    expires = time.time() + ttl
    srv = claim_port(lambda: Vault(token, expires, True), serve_ports_in_use())
    return launch(srv, token, {"name": VAULT, "kind": "vault", "note": ""}, ttl, host,
                  plain_http, expires)


def launch(srv, token, rec_fields, ttl, host, plain_http, expires=None):
    """Fork the detached server, wait for it to report its route is up, and
    return the link."""
    local_port = srv.server_address[1]
    tailnet_port = local_port   # never another number: see claim_port
    srv.allow_hosts(host, tailnet_port)
    rec = dict(rec_fields, id=secrets.token_hex(4), local_port=local_port,
               tailnet_port=tailnet_port, plain_http=plain_http, created=time.time(),
               expires=expires or time.time() + ttl)

    rfd, wfd = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(rfd)
        os.setsid()
        detach_stdio({srv.fileno(), wfd})
        rec["pid"] = os.getpid()
        try:
            serve_child(srv, rec, wfd)
        finally:
            os._exit(0)

    os.close(wfd)
    srv.server_close()
    chunks = []
    while True:
        chunk = os.read(rfd, 4096)
        if not chunk:
            break
        chunks.append(chunk)
    os.close(rfd)
    status = b"".join(chunks).decode(errors="replace")
    if status != "ok":
        raise KeydropError(status or "server exited before it was ready")
    scheme = "http" if plain_http else "https"
    return f"{scheme}://{host}:{tailnet_port}/{token}"


def cancel(name):
    hit = False
    for rec in read_pending():
        mine = rec.get("kind") == "vault" if name == "vault" else (
            rec["name"] == name and rec.get("kind") != "vault")
        if mine and alive(rec["pid"]):
            os.kill(rec["pid"], signal.SIGTERM)
            hit = True
    return hit


def status_lines():
    ensure_state()
    reap()
    now = time.time()
    out = []
    for rec in read_pending():
        where = (f"tailnet :{rec['tailnet_port']}{' (http)' if rec['plain_http'] else ''}"
                 if rec["tailnet_port"] else f"local :{rec['local_port']}")
        if rec.get("teardown_failed"):
            out.append(f"{rec['name']}\tteardown failed, retrying on every reap\t{where}")
            continue
        if rec.get("kind") == "home":
            out.append(f"{rec['name']}\talways on\t{where}\tpid {rec['pid']}")
            continue
        left = max(0, int(rec["expires"] - now))
        out.append(f"{rec['name']}\t{left // 60}m{left % 60:02d}s left\t{where}\tpid {rec['pid']}")
    st = read_home()
    for flag in ("locked", "stopped"):
        if st.get(flag):
            out.append(f"{HOME}\t{flag} since {when(st[flag].get('at'))} ({st[flag].get('why', '')})"
                       "\tkeydrop home --unlock clears it")
    return out

# ---------- home ----------

class home_lock(serve_lock):
    FILE = "home.lock"


def read_home():
    """home.json: the link's SHA-256, recent bad requests and writes, the
    lockout and stop flags, and the port it last served on. No token, no value."""
    try:
        with open(HOME_FILE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def update_home(fn):
    """Read, change and replace home.json whole under its lock. fn gets a
    copy and returns the new state."""
    with home_lock():
        new = fn(dict(read_home()))
        tmp = HOME_FILE + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(new, f, sort_keys=True)
        os.replace(tmp, HOME_FILE)
        return new


def recent(stamps, window, now=None):
    now = time.time() if now is None else now
    return [t for t in stamps or [] if isinstance(t, (int, float)) and now - t < window]


def audit_line(name, event):
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    fd = os.open(AUDIT_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(f"{stamp}\t{name}\t{event}\n")


class HomeHandler(VaultHandler):
    """The vault handler, made safe to leave up. Strikes persist and lock the
    page until the owner unlocks it on the Mac, so nothing a web page they
    visit, or another tailnet node, can make happen may count as one:

    - a request a browser marks as from another site gets a bare 404 first;
    - a request without the owner's login gets a bare 404, no strike (serve
      sets the login from WhoIs, so it can't get in) and is not rate-charged,
      so a peer can't spend the owner's per-minute budget;
    - a strike needs the owner's login AND Sec-Fetch-Site of same-origin or none.
      Browsers only send Fetch Metadata to HTTPS origins, and a request
      without it (an <img> on some page, curl) can't be told from a
      cross-site one, so it gets a bare 404 with no strike. This is also why
      home has no --http.

    The per-minute limit (429) applies to requests carrying the owner's login."""

    def _turned_away(self):
        site = (self.headers.get("Sec-Fetch-Site") or "").lower()
        if site in ("cross-site", "same-site"):
            self._send(404, b"", "text/plain")
            return True
        return False

    def _strike_eligible(self):
        sites = self.headers.get_all("Sec-Fetch-Site") or []
        return len(sites) == 1 and sites[0].strip().lower() in ("same-origin", "none")

    def _admitted(self):
        if self.server.under_rate():
            return True
        self._send(429, b"", "text/plain")
        return False

    def _login_refused(self, path):
        """No strike. serve overwrites Tailscale-User-Login from WhoIs, so a
        request without the owner's login can never get in, and counting it
        would only let any other tailnet node lock the page. Strikes are for
        requests carrying the owner's login with a wrong path or form token."""
        self._send(404, b"", "text/plain")

    def _reject(self):
        if self._screened():
            return
        self.server.requests += 1
        path = urllib.parse.urlsplit(self.path).path
        if self._login_passes(path) and self._admitted():
            self._not_found(path)

    do_HEAD = do_PUT = do_DELETE = do_PATCH = do_OPTIONS = _reject


class Home(Vault):
    """The vault, always on. The counters that matter live in home.json, so
    a restart (or a crash and a launchd respawn) starts where it left off."""
    max_requests = float("inf")
    handler = HomeHandler
    title, done_label = "keydrop", "Stop this page"
    done_outcome = "stopped"
    done_message = "Stopped. It stays down until keydrop home --unlock is run on the Mac."
    label = "home"

    def __init__(self, pin=True, port=None):
        """port: HOME_PORT unless a unit test needs a second one beside it."""
        self.started = time.time()
        self._csrf_key = secrets.token_bytes(32)
        self._minute, self._refusals = [], []
        self._next_watch = 0.0
        super().__init__(None, None, pin, HOME, HOME_PORT if port is None else port)

    def watch(self, now=None, status=None):
        """Every watch_interval() seconds, read `serve status`; if the route
        for HOME_PORT is gone or no longer proxies here, end the loop so the
        listener closes before netstack forwards a peer straight to it."""
        now = time.time() if now is None else now
        if not self.listening or now < self._next_watch:
            return None
        self._next_watch = now + watch_interval()
        if route_ours(serve_status() if status is None else status, HOME_PORT):
            return None
        return "route-gone"

    # The path token is checked against the SHA-256 in home.json, read per
    # request, so `home --new-link` kills the old bookmark without a restart.
    def token_ok(self, path):
        want = read_home().get("token_sha256") or ""
        if not re.fullmatch(r"[0-9a-f]{64}", want):
            return False
        guess = path[1:] if path.startswith("/") else path
        return hmac.compare_digest(hashlib.sha256(guess.encode("utf-8", "replace")).digest(),
                                   bytes.fromhex(want))

    # Strikes are persisted. Handler code does `server.bad += 1`; the setter
    # records the new strikes and locks the page once there are MAX_BAD in
    # the window.
    # A lock or a stop reads as a full count, so run_until_done ends the
    # serve loop as soon as either is set, whoever set it.
    @staticmethod
    def _strike_count(st, now=None):
        if st.get("locked") or st.get("stopped"):
            return MAX_BAD
        return len(recent(st.get("bad"), HOME_BAD_WINDOW, now))

    @property
    def bad(self):
        return self._strike_count(read_home())

    @bad.setter
    def bad(self, value):
        def add(st):
            now = time.time()
            strikes = recent(st.get("bad"), HOME_BAD_WINDOW, now)
            more = value - self._strike_count(st, now)
            if more <= 0:
                return st
            strikes = strikes + [now] * more
            locked = st.get("locked") or (
                {"at": now, "why": f"{len(strikes)} bad requests"} if len(strikes) >= MAX_BAD else None)
            return dict(st, bad=strikes, locked=locked)
        update_home(add)

    def refusal(self):
        st = read_home()
        for flag in ("locked", "stopped"):
            if st.get(flag):
                return flag
        return None

    # Sliding one-minute buckets. A request over the limit isn't recorded,
    # so a bucket never holds more than REQUESTS_PER_MINUTE stamps.
    def _within_minute(self, attr):
        now = time.time()
        kept = [t for t in getattr(self, attr) if now - t < 60]
        ok = len(kept) < REQUESTS_PER_MINUTE
        setattr(self, attr, kept + [now] if ok else kept)
        return ok

    def under_rate(self):
        """The owner's budget: charged only once a request has passed the login pin."""
        return self._within_minute("_minute")

    def may_log_refusal(self):
        """Refused logins aren't rate-charged, so their log lines are capped
        on their own bucket instead of growing keydrop.log without bound."""
        return self._within_minute("_refusals")

    # Form tokens are stamped and MACed with a per-process key, so each page
    # gets a fresh one and any open tab keeps working. An old one that is
    # really ours is "stale" (reload, no strike); a forged one is "bad".
    # A well-formed token stamped in an earlier second than this process
    # started can't be checked (its key died with the old process): that is
    # a tab left open across a restart, so it is "stale" too. A forger can
    # pick an old stamp to dodge the strike, but not to get in.
    def issue_csrf(self):
        stamp = str(int(time.time()))
        mac = hmac.new(self._csrf_key, stamp.encode(), hashlib.sha256).hexdigest()
        return f"{stamp}.{mac}"

    def check_csrf(self, given):
        stamp, _, mac = (given or "").partition(".")
        if not re.fullmatch(r"[0-9]{1,12}", stamp):
            return "bad"
        want = hmac.new(self._csrf_key, stamp.encode(), hashlib.sha256).hexdigest()
        if not hmac.compare_digest(mac.encode("utf-8", "replace"), want.encode()):
            prestart = int(stamp) < int(self.started)
            return "stale" if prestart and re.fullmatch(r"[0-9a-f]{64}", mac) else "bad"
        age = time.time() - int(stamp)
        return "ok" if -60 <= age <= CSRF_MAX_AGE else "stale"

    def write_allowed(self):
        """Checks and books a write in one locked step."""
        verdict = []

        def book(st):
            now = time.time()
            writes = recent(st.get("writes"), WRITE_WINDOW, now)
            verdict.append(len(writes) < WRITE_LIMIT)
            return dict(st, writes=writes + [now] if verdict[0] else writes)
        update_home(book)
        return verdict[0]

    def audit(self, name, event):
        super().audit(name, event)
        audit_line(name, event)


def home_route(status, port):
    """The local port the home route at :port proxies to, or None if :port
    isn't a single `/` proxy to 127.0.0.1 (so not ours to touch)."""
    port = str(port)
    entry = (status.get("TCP") or {}).get(port)
    hosts = [h for h in (status.get("Web") or {}) if h.rsplit(":", 1)[-1] == port]
    if not isinstance(entry, dict) or len(hosts) != 1:
        return None
    handlers = (status["Web"][hosts[0]] or {}).get("Handlers") or {}
    m = re.fullmatch(r"http://127\.0\.0\.1:(\d+)", ((handlers.get("/") or {}).get("Proxy") or ""))
    return int(m.group(1)) if m and set(handlers) == {"/"} else None


def home_backend(backend, port):
    """Whether a route's backend is keydrop home's: home always proxies to
    127.0.0.1 on the same port number as its tailnet port."""
    return backend is not None and backend == int(port)


def watch_interval():
    try:
        n = float(os.environ.get("KEYDROP_WATCH_INTERVAL") or WATCH_INTERVAL)
    except ValueError:
        n = WATCH_INTERVAL
    return min(max(n, 0.1), WATCH_INTERVAL)


def home_new_link():
    """Mints the path token, keeps only its SHA-256, prints the URL once.
    Whoever runs this sees the token; nothing else ever does."""
    ensure_state()
    host = tailnet_host(http_hint=False)
    token = secrets.token_urlsafe(32)
    update_home(lambda st: dict(st, token_sha256=hashlib.sha256(token.encode()).hexdigest()))
    log(HOME, "new link")
    return f"https://{host}:{HOME_PORT}/{token}"


def home():
    """Runs in the foreground until stopped, locked out, or killed. Exit 0
    means "stay down" (launchd's KeepAlive only restarts on failure)."""
    ensure_state()
    st = read_home()
    for flag in ("locked", "stopped"):
        if st.get(flag):
            print(f"keydrop home: {flag} ({st[flag].get('why', '')}); "
                  "`keydrop home --unlock` on the Mac clears it", file=sys.stderr)
            return 0
    if not st.get("token_sha256"):
        print("keydrop home: no link yet; run `keydrop home --new-link` first", file=sys.stderr)
        return 0
    reap()
    if any(r.get("kind") == "home" and not r.get("teardown_failed") for r in read_pending()):
        raise KeydropError("the home page is already running")
    host = tailnet_host(http_hint=False)
    if str(HOME_PORT) in serve_ports_in_use():
        raise KeydropError(f"tailnet port {HOME_PORT} is already served by something else")
    srv = Home(pin=True)   # binds 127.0.0.1:HOME_PORT, doesn't listen yet
    srv.allow_hosts(host, HOME_PORT)
    rec = {"name": HOME, "kind": "home", "note": "", "id": secrets.token_hex(4),
           "local_port": HOME_PORT, "tailnet_port": HOME_PORT,
           "plain_http": False, "created": time.time(), "expires": None, "pid": os.getpid()}
    update_home(lambda st: dict(st, port=rec["tailnet_port"], plain_http=False))
    rfd, wfd = os.pipe()
    outcome = serve_child(srv, rec, wfd)
    os.set_blocking(rfd, False)
    try:
        report = os.read(rfd, 4096).decode(errors="replace")
    except BlockingIOError:
        report = ""
    os.close(rfd)
    if outcome == "stopped":
        mark_stopped("the page's Stop button")
    if outcome in ("stopped", "locked-out") or outcome.startswith(("cancelled", "refused")):
        return 0
    if outcome == "route-gone":
        raise KeydropError(f"the serve route for :{HOME_PORT} went away while the page was up; "
                           "closed the listener so netstack can't forward peers to it")
    if report and report != "ok":
        raise KeydropError(report)
    raise KeydropError(f"home page ended: {outcome}")


def mark_stopped(why):
    update_home(lambda st: dict(st, stopped={"at": time.time(), "why": why}))
    log(HOME, f"stopped ({why})")


def home_stop():
    """The kill switch. Flag first, so a launchd respawn stays down; then end
    the process (its own teardown removes the route) and remove the route
    directly in case the process was already dead. True only once serve
    status confirms no route on the port still proxies to home's backend.
    The flag and the process lookup both live in this config's state dir: a
    page started with another one is only reached through its route."""
    ensure_state()
    with serve_lock():
        # A starting page writes its record, then reads this flag; we write
        # the flag, then read records. Either it sees the flag and refuses,
        # or we see its record and SIGTERM it. That ordering is what makes a
        # stop during start-up safe; the lock only narrows the window further.
        mark_stopped("home --stop")
    pids = [r["pid"] for r in read_pending()
            if r.get("kind") == "home" and not r.get("teardown_failed") and alive(r["pid"])]
    for pid in pids:
        os.kill(pid, signal.SIGTERM)
    end = time.time() + 15
    while time.time() < end and any(alive(p) for p in pids):
        time.sleep(0.1)
    reap()
    st = read_home()
    # No port in this state dir's home.json doesn't mean nothing is serving:
    # a page run under another config (the launchd job, say) wrote its own.
    # So check HOME_PORT anyway, and only report stopped once serve agrees.
    port = st.get("port") or HOME_PORT
    with serve_lock():
        status = serve_status()
        if status is None:
            return False
        backend = home_route(status, port) if str(port) in (status.get("TCP") or {}) else None
        if str(port) in (status.get("TCP") or {}) and not home_backend(backend, port):
            # someone else's route on our port: say what's there, leave it
            print(f"keydrop: :{port} is routed to {backend or 'something else'}, not "
                  f"keydrop home; leaving it", file=sys.stderr)
            return False
        if backend is not None:
            serve_off(port, st.get("plain_http", False))
            status = serve_status()
    return status is not None and str(port) not in (status.get("TCP") or {})


def home_unlock():
    update_home(lambda st: dict(st, bad=[], locked=None, stopped=None))
    log(HOME, "unlocked")


# ---------- cli ----------

USAGE = __doc__.split("\n\n")[1] + """
    request <name> --type credential [--fields totp,url,notes]
                                          username + password, plus the optional fields asked for
    request <name> --template <service>   propose a known service's fields (also --type <service>)
    request <name> --schema <file.json>   a validated service + field definition
    request <name> --fields '<JSON list>' custom fields (definitions, never values)
    request <name> --type secret          one value, the default

Anything but secret needs "types_enabled": ["secret", "credential"] in
policy.json in the state directory. SPEC.md section 5 has the field model.
"""


NO_LOCAL = ("has no --local: a loopback listener with no serve route on its port is "
            "reachable by every tailnet peer through tailscaled's userspace networking, "
            "with any identity headers it likes")


def env_overrides():
    return sorted(k for k in os.environ if k.startswith("KEYDROP_"))


def home_cli(rest):
    flags = set(rest)
    if "--http" in flags:
        raise KeydropError("home is HTTPS only: browsers send no Fetch Metadata over plain "
                           "HTTP, and without it the lockout can't tell the owner from any "
                           "page they visit. Enable HTTPS certificates for the tailnet instead")
    if "--local" in flags:
        raise KeydropError("home " + NO_LOCAL)
    force = "--force" in flags
    flags.discard("--force")
    known = {"--new-link", "--stop", "--unlock"}
    if (flags - known or len(set(rest)) != len(rest) or len(flags) > 1
            or (force and not flags)):
        raise KeydropError("usage: keydrop home | --new-link | --stop | --unlock  [--force]")
    # The launchd job has no EnvironmentVariables: it runs on the config file
    # alone. With KEYDROP_* set here, these commands may act on a different
    # state dir or port than the page that's actually up.
    env = env_overrides()
    if flags and env and not force:
        what = (f"KEYDROP_* is set here ({', '.join(env)}), so this may not be the "
                f"state dir or port the launchd page uses (it reads only {CONFIG_PATH}).")
        if "--stop" in flags:
            print(f"keydrop: WARNING: {what} Stopping anyway; if the page comes back, "
                  "unset them and run --stop again.", file=sys.stderr)
        else:
            raise KeydropError(f"{what} Unset them, or add --force if this is the config you mean")
    if not flags & {"--stop", "--unlock"}:
        require_owner()
    if "--new-link" in flags:
        print(home_new_link())
        print("Bookmark it. This is the only time it's shown; --new-link again replaces it.",
              file=sys.stderr)
        return 0
    if "--stop" in flags:
        if not home_stop():
            print("keydrop: stop flag set, but couldn't confirm the serve route is gone "
                  "(is tailscaled up?); run --stop again", file=sys.stderr)
            return 1
        print("home page stopped; it stays down until `keydrop home --unlock`")
        return 0
    if "--unlock" in flags:
        home_unlock()
        print("unlocked. Start it again with: "
              f"launchctl kickstart gui/$(id -u)/{LAUNCHD_LABEL}")
        return 0
    return home()


def config_lines():
    return [f"config file      {CONFIG_PATH}" + ("" if os.path.exists(CONFIG_PATH) else " (not found)"),
            f"owner_login      {OWNER_LOGIN or '(not set: request, vault and home will refuse to start)'}",
            f"account          {ACCOUNT}",
            f"service_prefix   {SERVICE_PREFIX}",
            f"state_dir        {STATE_DIR}",
            f"launchd_label    {LAUNCHD_LABEL}",
            f"home_port        {HOME_PORT}",
            f"tailscale        {TAILSCALE}",
            f"tailscale_socket {TS_SOCKET or '(default)'}"]


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    try:
        require_config(stop=(cmd == "home" and "--stop" in rest))
        if cmd == "config" and not rest:
            for line in config_lines():
                print(line)
            return 0
        if cmd == "request":
            name, note, ttl, plain_http = None, "", DEFAULT_TTL, False
            schema_path, typ, template, fields_arg = None, None, None, None
            it = iter(rest)
            for a in it:
                if a == "--note":
                    note = next(it, "")
                elif a == "--schema":
                    schema_path = next(it, "")
                elif a == "--type":
                    typ = next(it, "")
                elif a == "--template":
                    template = next(it, "")
                elif a == "--fields":
                    fields_arg = next(it, "")
                elif a == "--ttl":
                    ttl = parse_ttl(next(it, ""))
                elif a == "--http":
                    plain_http = True
                elif a == "--local":
                    raise KeydropError("request " + NO_LOCAL)
                elif name is None and not a.startswith("-"):
                    name = a
                else:
                    raise KeydropError(f"unexpected argument {a!r}")
            if name is None:
                raise KeydropError("request needs a name")
            schema = request_schema(name, typ, template, fields_arg, schema_path)
            require_owner()
            print(request(name, note, ttl, plain_http, schema))
            return 0
        if cmd == "vault":
            ttl, plain_http = DEFAULT_TTL, False
            it = iter(rest)
            for a in it:
                if a == "--ttl":
                    ttl = parse_ttl(next(it, ""))
                elif a == "--http":
                    plain_http = True
                elif a == "--local":
                    raise KeydropError("vault " + NO_LOCAL)
                else:
                    raise KeydropError(f"unexpected argument {a!r}")
            require_owner()
            print(vault(ttl, plain_http))
            return 0
        if cmd == "home":
            return home_cli(rest)
        if cmd == "get" and (len(rest) == 1 or len(rest) == 3 and rest[1] == "--field"):
            if not valid_name(rest[0]):
                raise KeydropError("bad name")
            value = STORE.get(rest[0])
            if value is None:
                print(f"keydrop: no key named {rest[0]}", file=sys.stderr)
                return 1
            value = item_value(rest[0], value, rest[2] if len(rest) == 3 else None)
            sys.stdout.write(value + ("\n" if sys.stdout.isatty() else ""))
            return 0
        if cmd == "list" and rest in ([], ["--long"]):
            entries = STORE.list()
            for n in sorted(entries):
                e = entries[n]
                print("\t".join([n, e.get("type", "secret"), iso(e.get("created")), iso(e.get("updated"))])
                      if rest else n)
            return 0
        if cmd == "status" and not rest:
            lines = status_lines()
            print("\n".join(lines) if lines else "no pending requests")
            return 0
        if cmd == "cancel" and len(rest) == 1:
            if not cancel(rest[0]):
                print(f"keydrop: nothing pending for {rest[0]}", file=sys.stderr)
                return 1
            return 0
        print(USAGE, file=sys.stderr)
        return 2
    except KeydropError as e:
        print(f"keydrop: {e}", file=sys.stderr)
        return e.exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
